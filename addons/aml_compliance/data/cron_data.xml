<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================ -->
        <!-- Server Actions for Cron Jobs                  -->
        <!-- ============================================ -->

        <!-- Server Action: Transaction Monitoring -->
        <record id="sa_transaction_monitoring" model="ir.actions.server">
            <field name="name">AML: Transaction Monitoring Scan</field>
            <field name="model_id" ref="model_aml_transaction_alert"/>
            <field name="state">code</field>
            <field name="code">model.run_transaction_monitoring()</field>
        </record>

        <!-- Server Action: Batch Screening -->
        <record id="sa_batch_screening" model="ir.actions.server">
            <field name="name">AML: Batch Sanctions Screening</field>
            <field name="model_id" ref="model_aml_screening_result"/>
            <field name="state">code</field>
            <field name="code">model.run_batch_screening()</field>
        </record>

        <!-- Server Action: Free Sanctions Sync -->
        <record id="sa_free_sanctions_sync" model="ir.actions.server">
            <field name="name">AML: Free Sanctions Sources Sync</field>
            <field name="model_id" ref="model_aml_opensanctions_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_free_lists()</field>
        </record>

        <!-- Server Action: Full Dataset Sync -->
        <record id="sa_full_sanctions_sync" model="ir.actions.server">
            <field name="name">AML: Full OpenSanctions Dataset Sync (1.2M+)</field>
            <field name="model_id" ref="model_aml_opensanctions_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_full_dataset()</field>
        </record>

        <!-- Server Action: Periodic Review -->
        <record id="sa_periodic_review" model="ir.actions.server">
            <field name="name">AML: Periodic Review Reminder</field>
            <field name="model_id" ref="model_aml_risk_assessment"/>
            <field name="state">code</field>
            <field name="code">model.run_periodic_review_check()</field>
        </record>

        <!-- Server Action: Document Expiry -->
        <record id="sa_document_expiry" model="ir.actions.server">
            <field name="name">AML: Document Expiry Monitor</field>
            <field name="model_id" ref="model_aml_risk_assessment"/>
            <field name="state">code</field>
            <field name="code">model.run_document_expiry_check()</field>
        </record>

        <!-- ============================================ -->
        <!-- Cron Jobs (Odoo 19 use ir_actions_server_id)  -->
        <!-- ============================================ -->

        <record id="cron_transaction_monitoring" model="ir.cron">
            <field name="name">AML: Transaction Monitoring Scan</field>
            <field name="ir_actions_server_id" ref="sa_transaction_monitoring"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <record id="cron_batch_screening" model="ir.cron">
            <field name="name">AML: Batch Sanctions Screening</field>
            <field name="ir_actions_server_id" ref="sa_batch_screening"/>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <record id="cron_free_sanctions_sync" model="ir.cron">
            <field name="name">AML: Free Sanctions Sources Sync</field>
            <field name="ir_actions_server_id" ref="sa_free_sanctions_sync"/>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <record id="cron_full_sanctions_sync" model="ir.cron">
            <field name="name">AML: Full OpenSanctions Dataset Sync (1.2M+)</field>
            <field name="ir_actions_server_id" ref="sa_full_sanctions_sync"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <record id="cron_periodic_review" model="ir.cron">
            <field name="name">AML: Periodic Review Reminder</field>
            <field name="ir_actions_server_id" ref="sa_periodic_review"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <record id="cron_document_expiry" model="ir.cron">
            <field name="name">AML: Document Expiry Monitor</field>
            <field name="ir_actions_server_id" ref="sa_document_expiry"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

    </data>
</odoo>
