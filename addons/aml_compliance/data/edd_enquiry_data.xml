<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Default EDD Enquiry Types per CBUAE / FATF RBA guidance -->
        <record id="edd_enquiry_source_funds" model="aml.edd.enquiry.type">
            <field name="name">Source of Funds</field>
            <field name="code">SOURCE_FUNDS</field>
            <field name="sequence">10</field>
            <field name="required">True</field>
        </record>

        <record id="edd_enquiry_source_wealth" model="aml.edd.enquiry.type">
            <field name="name">Source of Wealth</field>
            <field name="code">SOURCE_WEALTH</field>
            <field name="sequence">20</field>
            <field name="required">True</field>
        </record>

        <record id="edd_enquiry_business_nature" model="aml.edd.enquiry.type">
            <field name="name">Nature of Business</field>
            <field name="code">BUSINESS_NATURE</field>
            <field name="sequence">30</field>
            <field name="required">True</field>
        </record>

        <record id="edd_enquiry_expected_activity" model="aml.edd.enquiry.type">
            <field name="name">Expected Account Activity</field>
            <field name="code">EXPECTED_ACTIVITY</field>
            <field name="sequence">40</field>
            <field name="required">True</field>
        </record>

        <record id="edd_enquiry_country_risk" model="aml.edd.enquiry.type">
            <field name="name">Country Risk Clarification</field>
            <field name="code">COUNTRY_RISK</field>
            <field name="sequence">50</field>
            <field name="required">False</field>
        </record>

        <record id="edd_enquiry_pep_clarification" model="aml.edd.enquiry.type">
            <field name="name">PEP Relationship Clarification</field>
            <field name="code">PEP_CLARIFICATION</field>
            <field name="sequence">60</field>
            <field name="required">False</field>
        </record>

    </data>
</odoo>
