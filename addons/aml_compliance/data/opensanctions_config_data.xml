<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default OpenSanctions configuration.

        Required for the sanctions sync crons (AML: Free Sanctions Sources Sync
        and AML: Full OpenSanctions Dataset Sync): ``cron_sync_free_lists`` and
        ``cron_sync_full_dataset`` iterate the *active* config records, so with
        no record the local sanctions list is never populated and screening can
        never match anything. This singleton fixes that. -->
        <record id="opensanctions_default_config" model="aml.opensanctions.config">
            <field name="name">Default OpenSanctions Config</field>
            <field name="mode">cloud</field>
            <field name="api_url">https://api.opensanctions.org</field>
            <field name="dataset">default</field>
            <field name="score_threshold">0.70</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
