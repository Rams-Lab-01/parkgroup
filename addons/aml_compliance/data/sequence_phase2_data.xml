<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- goAML Report Sequence -->
        <record id="seq_goaml_report" model="ir.sequence">
            <field name="name">goAML Report</field>
            <field name="code">aml.goaml.report</field>
            <field name="prefix">FIU/%(year)s/</field>
            <field name="padding">4</field>
        </record>

        <!-- Transaction Alert Sequence -->
        <record id="seq_transaction_alert" model="ir.sequence">
            <field name="name">Transaction Alert</field>
            <field name="code">aml.transaction.alert</field>
            <field name="prefix">ALT/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <!-- Screening Result Sequence -->
        <record id="seq_screening_result" model="ir.sequence">
            <field name="name">Screening Result</field>
            <field name="code">aml.screening.result</field>
            <field name="prefix">SCR/%(year)s/</field>
            <field name="padding">5</field>
        </record>

    </data>
</odoo>
