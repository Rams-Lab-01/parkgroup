    <!-- AML Configuration        -->
    <!-- (under KYC Configuration)-->
    <!-- ======================== -->
    <menuitem id="menu_aml_config_risk_factors"
              name="Risk Factors"
              parent="kyc_management.menu_kyc_configuration"
              action="action_risk_factor"
              sequence="10"/>

    <menuitem id="menu_aml_config_fatf"
              name="FATF Jurisdictions"
              parent="kyc_management.menu_kyc_configuration"
              action="action_fatf_jurisdiction"
              sequence="11"/>

    <menuitem id="menu_aml_config_monitoring_rules"
              name="Monitoring Rules"
              parent="kyc_management.menu_kyc_configuration"
              action="action_monitoring_rule"
              sequence="12"/>

    <menuitem id="menu_aml_config_opensanctions"
              name="OpenSanctions / Yente"
              parent="kyc_management.menu_kyc_configuration"
              action="action_opensanctions_config"
              sequence="13"
              groups="aml_compliance.group_aml_manager"/>

</odoo>
