<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- OpenSanctions / Yente Configuration Views                    -->
    <!-- ============================================================ -->

    <record id="view_opensanctions_config_form" model="ir.ui.view">
        <field name="name">aml.opensanctions.config.form</field>
        <field name="model">aml.opensanctions.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Connection status banner -->
                    <div class="alert alert-success mb-3"
                         role="alert"
                         invisible="connection_status != 'ok'">
                        <i class="fa fa-check-circle me-2"/>
                        <strong>Connected</strong> — OpenSanctions API is reachable.
                        <span class="ms-2 text-muted">
                            Last checked: <field name="last_check" readonly="1" nolabel="1"/>
                        </span>
                    </div>
                    <div class="alert alert-warning mb-3"
                         role="alert"
                         invisible="connection_status != 'unknown'">
                        <i class="fa fa-question-circle me-2"/>
                        Connection has not been tested yet. Click <strong>Test Connection</strong>.
                    </div>
                    <div class="alert alert-danger mb-3"
                         role="alert"
                         invisible="connection_status != 'error'">
                        <i class="fa fa-times-circle me-2"/>
                        <strong>Connection Error:</strong>
                        <field name="status_message" readonly="1" nolabel="1"/>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" placeholder="Configuration Name"/></h1>
                    </div>

                    <group>
                        <group string="API Settings">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="mode"/>
                            <field name="api_url"
                                   placeholder="https://api.opensanctions.org"/>
                            <field name="api_key"
                                   password="True"
                                   placeholder="Optional — leave blank for free unauthenticated access"/>
                            <field name="dataset"
                                   placeholder="default"/>
                            <field name="algorithm"/>
                            <field name="score_threshold"
                                   widget="float"
                                   help="0.70 = 70% match score threshold (recommended)"/>
                            <field name="result_limit"/>
                            <field name="timeout"/>
                        </group>
                        <group string="Connection Status">
                            <field name="connection_status"
                                   widget="badge"
                                   decoration-success="connection_status == 'ok'"
                                   decoration-warning="connection_status == 'unknown'"
                                   decoration-danger="connection_status == 'error'"/>
                            <field name="last_check" readonly="1"/>
                        </group>
                    </group>

                    <div class="o_row mt-3">
                        <button name="action_test_connection"
                                string="Test Connection"
                                type="object"
                                class="btn btn-primary"
                                icon="fa-plug"/>
                        <button name="action_import_free_sanctions_lists"
                                string="Import Free Lists"
                                type="object"
                                class="btn btn-secondary ms-2"
                                icon="fa-download"/>
                        <button name="action_schedule_full_dataset_import"
                                string="Schedule Full Import (1.2M+ records)"
                                type="object"
                                class="btn btn-warning ms-2"
                                icon="fa-database"
                                confirm="This will queue a background import of the full OpenSanctions default dataset (~1.2 million records). The import runs via the monthly cron and will take several minutes. Continue?"/>
                    </div>

                    <group string="Local Sanctions Data">
                        <group>
                            <field name="local_sanctions_count" readonly="1"/>
                            <field name="last_sync_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_sync_at" readonly="1"/>
                        </group>
                        <field name="last_sync_summary" readonly="1" nolabel="1"/>
                    </group>

                    <!-- Cloud API setup notes -->
                    <group string="Cloud API Setup (Recommended — No Docker Required)"
                           invisible="mode != 'cloud'">
                        <div class="o_field_html" colspan="2">
                            <p>
                                The <strong>OpenSanctions Cloud API</strong> is free to use and covers
                                <strong>UN, OFAC, EU, UAE, and 100+ sanctions &amp; PEP lists</strong>.
                                No installation needed.
                            </p>
                            <ol>
                                <li>Set <strong>API Base URL</strong> to <code>https://api.opensanctions.org</code></li>
                                <li>Optionally get a <strong>free API key</strong> at
                                    <a href="https://www.opensanctions.org/api/" target="_blank">opensanctions.org/api</a>
                                    for higher rate limits (10,000 req/month free with key)</li>
                                <li>Click <strong>Test Connection</strong> to verify</li>
                            </ol>
                            <p class="text-muted">
                                <strong>Dataset options:</strong>
                                <code>default</code> (all lists) •
                                <code>sanctions</code> (sanctions-only) •
                                <code>peps</code> (PEPs only)
                            </p>
                        </div>
                    </group>

                    <!-- Self-hosted yente setup notes -->
                    <group string="Self-Hosted Yente Setup"
                           invisible="mode != 'selfhosted'">
                        <div class="o_field_html" colspan="2">
                            <p><strong>Quick start with Docker:</strong></p>
                            <pre class="bg-light p-2 rounded" style="font-size:12px;">mkdir yente &amp;&amp; cd yente
wget https://raw.githubusercontent.com/opensanctions/yente/main/docker-compose.yml
docker-compose up -d</pre>
                            <p>
                                Set <strong>API Base URL</strong> to
                                <code>http://&lt;your-server-ip&gt;:8000</code>.
                            </p>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_opensanctions_config_tree" model="ir.ui.view">
        <field name="name">aml.opensanctions.config.tree</field>
        <field name="model">aml.opensanctions.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mode" widget="badge"/>
                <field name="api_url"/>
                <field name="dataset"/>
                <field name="algorithm"/>
                <field name="score_threshold"/>
                <field name="connection_status" widget="badge"
                       decoration-success="connection_status == 'ok'"
                       decoration-warning="connection_status == 'unknown'"
                       decoration-danger="connection_status == 'error'"/>
                <field name="last_check"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_opensanctions_config" model="ir.actions.act_window">
        <field name="name">OpenSanctions / Yente Config</field>
        <field name="res_model">aml.opensanctions.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure OpenSanctions</p>
            <p>
                Add your self-hosted yente API configuration to enable live
                multi-source sanctions screening against UN, OFAC, EU, and 100+ lists.
            </p>
        </field>
    </record>

</odoo>
