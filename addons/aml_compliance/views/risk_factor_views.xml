<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================== -->
    <!-- Risk Factor Config Views    -->
    <!-- ========================== -->

    <record id="view_risk_factor_list" model="ir.ui.view">
        <field name="name">aml.risk.factor.list</field>
        <field name="model">aml.risk.factor</field>
        <field name="arch" type="xml">
            <list string="Risk Factors" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category" widget="badge"/>
                <field name="weight"/>
                <field name="max_score"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_risk_factor_form" model="ir.ui.view">
        <field name="name">aml.risk.factor.form</field>
        <field name="model">aml.risk.factor</field>
        <field name="arch" type="xml">
            <form string="Risk Factor">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="weight"/>
                            <field name="max_score"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_risk_factor" model="ir.actions.act_window">
        <field name="name">Risk Factors</field>
        <field name="res_model">aml.risk.factor</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure risk factors
            </p>
            <p>
                Define the weighted risk factors used by the AML scoring engine.
                Each factor contributes to the overall customer risk score.
            </p>
        </field>
    </record>

    <!-- ============================== -->
    <!-- FATF Jurisdiction Config Views  -->
    <!-- ============================== -->

    <record id="view_fatf_jurisdiction_list" model="ir.ui.view">
        <field name="name">aml.fatf.jurisdiction.list</field>
        <field name="model">aml.fatf.jurisdiction</field>
        <field name="arch" type="xml">
            <list string="FATF Jurisdictions"
                   decoration-danger="risk_level == 'black'"
                   decoration-warning="risk_level in ('grey', 'elevated')">
                <field name="country_id"/>
                <field name="risk_level" widget="badge"
                       decoration-danger="risk_level == 'black'"
                       decoration-warning="risk_level == 'grey'"
                       decoration-info="risk_level == 'elevated'"/>
                <field name="risk_score"/>
                <field name="date_listed"/>
                <field name="date_delisted"/>
                <field name="active"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="view_fatf_jurisdiction_form" model="ir.ui.view">
        <field name="name">aml.fatf.jurisdiction.form</field>
        <field name="model">aml.fatf.jurisdiction</field>
        <field name="arch" type="xml">
            <form string="FATF Jurisdiction">
                <sheet>
                    <group>
                        <group>
                            <field name="country_id"/>
                            <field name="risk_level"/>
                            <field name="risk_score"/>
                        </group>
                        <group>
                            <field name="date_listed"/>
                            <field name="date_delisted"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fatf_jurisdiction_search" model="ir.ui.view">
        <field name="name">aml.fatf.jurisdiction.search</field>
        <field name="model">aml.fatf.jurisdiction</field>
        <field name="arch" type="xml">
            <search string="FATF Jurisdictions">
                <field name="country_id"/>
                <filter name="filter_black" string="Black List"
                        domain="[('risk_level', '=', 'black')]"/>
                <filter name="filter_grey" string="Grey List"
                        domain="[('risk_level', '=', 'grey')]"/>
                <filter name="filter_elevated" string="Elevated"
                        domain="[('risk_level', '=', 'elevated')]"/>
                <filter name="filter_active" string="Currently Listed"
                        domain="[('date_delisted', '=', False)]"/>
                <group name="group_by">
                    <filter name="groupby_risk" string="Risk Level"
                            context="{'group_by': 'risk_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fatf_jurisdiction" model="ir.actions.act_window">
        <field name="name">FATF Jurisdictions</field>
        <field name="res_model">aml.fatf.jurisdiction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fatf_jurisdiction_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add FATF jurisdiction classifications
            </p>
            <p>
                Maintain the FATF high-risk (black list) and increased
                monitoring (grey list) country classifications. Updated
                per FATF plenary outcomes.
            </p>
        </field>
    </record>

</odoo>
