<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================ -->
    <!-- Risk Override Wizard Form View    -->
    <!-- ================================ -->

    <record id="view_risk_override_wizard_form" model="ir.ui.view">
        <field name="name">aml.risk.override.wizard.form</field>
        <field name="model">aml.risk.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Override Risk Level">
                <group>
                    <field name="assessment_id" readonly="1"/>
                    <field name="current_risk_level" widget="badge"
                           decoration-danger="current_risk_level == 'very_high'"
                           decoration-warning="current_risk_level == 'high'"
                           decoration-info="current_risk_level == 'medium'"
                           decoration-success="current_risk_level == 'low'"/>
                    <field name="new_risk_level"/>
                    <field name="reason" placeholder="Provide detailed justification (minimum 20 characters)..."/>
                </group>
                <footer>
                    <button name="action_confirm_override"
                            string="Confirm Override"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
