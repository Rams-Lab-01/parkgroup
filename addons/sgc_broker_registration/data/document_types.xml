<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="doctype_trade_license" model="sgc.broker.document.type">
            <field name="code">trade_license</field>
            <field name="name">Trade Licence</field>
            <field name="sequence">10</field>
            <field name="applicant_type">company</field>
            <field name="required" eval="True"/>
            <field name="has_expiry" eval="True"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">Valid trade licence that lists real estate brokerage as an activity.</field>
        </record>
        <record id="doctype_office_registration" model="sgc.broker.document.type">
            <field name="code">office_registration</field>
            <field name="name">Brokerage Office Registration Certificate (ORN)</field>
            <field name="sequence">20</field>
            <field name="applicant_type">company</field>
            <field name="required" eval="True"/>
            <field name="has_expiry" eval="True"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">Certificate issued by the real estate regulator of your emirate showing the brokerage office registration number.</field>
        </record>
        <record id="doctype_moa" model="sgc.broker.document.type">
            <field name="code">moa</field>
            <field name="name">Memorandum / Articles of Association</field>
            <field name="sequence">30</field>
            <field name="applicant_type">company</field>
            <field name="required" eval="True"/>
            <field name="has_expiry" eval="False"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">Latest MOA / AOA or partnership agreement, including any amendments.</field>
        </record>
        <record id="doctype_owner_ids" model="sgc.broker.document.type">
            <field name="code">owner_ids</field>
            <field name="name">Owners / Partners - Passport and Emirates ID</field>
            <field name="sequence">40</field>
            <field name="applicant_type">company</field>
            <field name="required" eval="True"/>
            <field name="has_expiry" eval="True"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">One combined PDF with the passport and Emirates ID of every owner and partner.</field>
        </record>
        <record id="doctype_signatory_id" model="sgc.broker.document.type">
            <field name="code">signatory_id</field>
            <field name="name">Authorised Signatory - Passport and Emirates ID</field>
            <field name="sequence">50</field>
            <field name="applicant_type">company</field>
            <field name="required" eval="True"/>
            <field name="has_expiry" eval="True"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">Passport and Emirates ID of the person signing the agreement.</field>
        </record>
        <record id="doctype_poa" model="sgc.broker.document.type">
            <field name="code">poa</field>
            <field name="name">Power of Attorney / Authorisation Letter</field>
            <field name="sequence">60</field>
            <field name="applicant_type">company</field>
            <field name="required" eval="False"/>
            <field name="has_expiry" eval="False"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">Only if the signatory is not an owner or the licensed manager.</field>
        </record>
        <record id="doctype_vat_certificate" model="sgc.broker.document.type">
            <field name="code">vat_certificate</field>
            <field name="name">VAT Registration Certificate</field>
            <field name="sequence">70</field>
            <field name="applicant_type">company</field>
            <field name="required" eval="False"/>
            <field name="has_expiry" eval="False"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">Upload if you are VAT registered (enter the TRN above).</field>
        </record>
        <record id="doctype_goaml" model="sgc.broker.document.type">
            <field name="code">goaml</field>
            <field name="name">goAML Registration Confirmation (FIU)</field>
            <field name="sequence">80</field>
            <field name="applicant_type">company</field>
            <field name="required" eval="True"/>
            <field name="has_expiry" eval="False"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">Confirmation of your registration on the UAE Financial Intelligence Unit goAML platform (AML obligation for real estate brokers).</field>
        </record>
        <record id="doctype_office_tenancy" model="sgc.broker.document.type">
            <field name="code">office_tenancy</field>
            <field name="name">Office Tenancy Contract / Ejari</field>
            <field name="sequence">90</field>
            <field name="applicant_type">company</field>
            <field name="required" eval="True"/>
            <field name="has_expiry" eval="True"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">Valid tenancy contract for the registered brokerage office.</field>
        </record>
        <record id="doctype_passport" model="sgc.broker.document.type">
            <field name="code">passport</field>
            <field name="name">Passport</field>
            <field name="sequence">100</field>
            <field name="applicant_type">individual</field>
            <field name="required" eval="True"/>
            <field name="has_expiry" eval="True"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">Colour copy of the passport photo page.</field>
        </record>
        <record id="doctype_emirates_id" model="sgc.broker.document.type">
            <field name="code">emirates_id</field>
            <field name="name">Emirates ID (front and back)</field>
            <field name="sequence">110</field>
            <field name="applicant_type">individual</field>
            <field name="required" eval="True"/>
            <field name="has_expiry" eval="True"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">Valid Emirates ID, both sides.</field>
        </record>
        <record id="doctype_residence_visa" model="sgc.broker.document.type">
            <field name="code">residence_visa</field>
            <field name="name">UAE Residence Visa</field>
            <field name="sequence">120</field>
            <field name="applicant_type">individual</field>
            <field name="required" eval="True"/>
            <field name="has_expiry" eval="True"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">Valid UAE residence visa page.</field>
        </record>
        <record id="doctype_broker_card" model="sgc.broker.document.type">
            <field name="code">broker_card</field>
            <field name="name">Regulator Broker Card / BRN Certificate</field>
            <field name="sequence">130</field>
            <field name="applicant_type">individual</field>
            <field name="required" eval="True"/>
            <field name="has_expiry" eval="True"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">Real estate broker card or registration certificate issued by the regulator.</field>
        </record>
        <record id="doctype_broker_exam" model="sgc.broker.document.type">
            <field name="code">broker_exam</field>
            <field name="name">Broker Training / Exam Certificate</field>
            <field name="sequence">140</field>
            <field name="applicant_type">individual</field>
            <field name="required" eval="False"/>
            <field name="has_expiry" eval="False"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">Regulator-recognised real estate broker course or exam certificate.</field>
        </record>
        <record id="doctype_photo" model="sgc.broker.document.type">
            <field name="code">photo</field>
            <field name="name">Passport-size Photo</field>
            <field name="sequence">150</field>
            <field name="applicant_type">individual</field>
            <field name="required" eval="True"/>
            <field name="has_expiry" eval="False"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">Recent photo with a plain background (JPG or PNG).</field>
        </record>
        <record id="doctype_employer_noc" model="sgc.broker.document.type">
            <field name="code">employer_noc</field>
            <field name="name">Employer NOC / Employment Contract</field>
            <field name="sequence">160</field>
            <field name="applicant_type">individual</field>
            <field name="required" eval="False"/>
            <field name="has_expiry" eval="False"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">If you work under a sponsoring brokerage.</field>
        </record>
        <record id="doctype_bank_letter" model="sgc.broker.document.type">
            <field name="code">bank_letter</field>
            <field name="name">Bank IBAN Letter / Cancelled Cheque</field>
            <field name="sequence">170</field>
            <field name="applicant_type">both</field>
            <field name="required" eval="True"/>
            <field name="has_expiry" eval="False"/>
            <field name="is_agreement" eval="False"/>
            <field name="description">Bank letter or cheque copy showing the account holder name and IBAN used for commission payments.</field>
        </record>
        <record id="doctype_signed_agreement" model="sgc.broker.document.type">
            <field name="code">signed_agreement</field>
            <field name="name">Signed Brokerage Agreement</field>
            <field name="sequence">180</field>
            <field name="applicant_type">both</field>
            <field name="required" eval="True"/>
            <field name="has_expiry" eval="False"/>
            <field name="is_agreement" eval="True"/>
            <field name="description">Download the agreement from this page, sign and stamp it, then upload the scan.</field>
        </record>
    </data>
</odoo>
