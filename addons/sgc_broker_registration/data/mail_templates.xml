<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_verification_code" model="mail.template">
            <field name="name">Broker registration: email verification code</field>
            <field name="model_id" ref="model_sgc_broker_application"/>
            <field name="subject">Your verification code: {{ ctx.get('code') }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px;">
    <p>Hello <t t-out="object.full_name"/>,</p>
    <p>Use this code to verify your email address for broker registration
       <b t-out="object.name"/>:</p>
    <p style="font-size: 28px; letter-spacing: 6px; font-weight: bold;" t-out="ctx.get('code')"/>
    <p>The code is valid for <t t-out="ctx.get('ttl', 10)"/> minutes. Enter it here:
       <a t-att-href="'%s/broker/verify/%s' % (object.get_base_url(), object.access_token)">verify my email</a>.
       If you did not request it, ignore this email.</p>
</div>
            </field>
        </record>

        <record id="mail_template_expiry_upcoming" model="mail.template">
            <field name="name">Broker registration: expiry reminder</field>
            <field name="model_id" ref="model_sgc_broker_application"/>
            <field name="subject">Reminder: {{ ctx.get('item_label') }} expires on {{ ctx.get('item_date') }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px;">
    <p>Dear <t t-out="object.full_name"/>,</p>
    <p>Your <b t-out="ctx.get('item_label')"/> with <t t-out="object.company_id.name"/> expires on
       <b t-out="ctx.get('item_date')"/> (in <t t-out="ctx.get('days_left')"/> day(s)).</p>
    <p>Please send us the renewed document before that date so your broker registration stays valid.
       If it is not renewed, your registration status will change to <b>Expired</b>.</p>
</div>
            </field>
        </record>

        <record id="mail_template_expiry_expired" model="mail.template">
            <field name="name">Broker registration: expired notice</field>
            <field name="model_id" ref="model_sgc_broker_application"/>
            <field name="subject">EXPIRED: {{ ctx.get('item_label') }} ({{ ctx.get('item_date') }})</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px;">
    <p>Dear <t t-out="object.full_name"/>,</p>
    <p>Your <b t-out="ctx.get('item_label')"/> with <t t-out="object.company_id.name"/>
       <t t-if="ctx.get('days_left') == 0"><b>expires today (<t t-out="ctx.get('item_date')"/>)</b>.</t>
       <t t-else=""><b>expired on <t t-out="ctx.get('item_date')"/></b>
       (<t t-out="ctx.get('days_left')"/> day(s) ago).</t></p>
    <p>Your broker registration is not valid until it is renewed. Please send us the renewed document
       immediately. We will keep reminding you until it is updated.</p>
</div>
            </field>
        </record>

        <record id="mail_template_resume_link" model="mail.template">
            <field name="name">Broker registration: resume link</field>
            <field name="model_id" ref="model_sgc_broker_application"/>
            <field name="subject">Continue your broker registration {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px;">
    <p>Dear <t t-out="object.full_name"/>,</p>
    <p>Someone (hopefully you) tried to register this email again. Your application
       <b t-out="object.name"/> is already in progress.</p>
    <p><a t-att-href="'%s/broker/application/%s' % (object.get_base_url(), object.access_token)">Continue your application</a></p>
</div>
            </field>
        </record>

        <record id="mail_template_submitted" model="mail.template">
            <field name="name">Broker registration: submission received</field>
            <field name="model_id" ref="model_sgc_broker_application"/>
            <field name="subject">Application {{ object.name }} received</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px;">
    <p>Dear <t t-out="object.full_name"/>,</p>
    <p>We received your broker registration application <b t-out="object.name"/>.
       Our compliance team will review your documents and contact you.</p>
    <p>You can follow the status any time here:
       <a t-att-href="'%s/broker/application/%s' % (object.get_base_url(), object.access_token)">Application status</a></p>
</div>
            </field>
        </record>

        <record id="mail_template_needs_info" model="mail.template">
            <field name="name">Broker registration: more information needed</field>
            <field name="model_id" ref="model_sgc_broker_application"/>
            <field name="subject">Action needed on application {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px;">
    <p>Dear <t t-out="object.full_name"/>,</p>
    <p>We need more information to continue with application <b t-out="object.name"/>:</p>
    <blockquote t-out="object.review_note"/>
    <p><a t-att-href="'%s/broker/application/%s' % (object.get_base_url(), object.access_token)">Open your application</a>
       to upload the corrected documents and submit again.</p>
</div>
            </field>
        </record>

        <record id="mail_template_approved" model="mail.template">
            <field name="name">Broker registration: approved</field>
            <field name="model_id" ref="model_sgc_broker_application"/>
            <field name="subject">Application {{ object.name }} approved</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px;">
    <p>Dear <t t-out="object.full_name"/>,</p>
    <p>Your broker registration <b t-out="object.name"/> has been <b>approved</b>.
       You are now registered as a broker with <t t-out="object.company_id.name"/>.</p>
</div>
            </field>
        </record>

        <record id="mail_template_rejected" model="mail.template">
            <field name="name">Broker registration: rejected</field>
            <field name="model_id" ref="model_sgc_broker_application"/>
            <field name="subject">Application {{ object.name }} - decision</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px;">
    <p>Dear <t t-out="object.full_name"/>,</p>
    <p>We are unable to approve application <b t-out="object.name"/> at this time.</p>
    <blockquote t-out="object.review_note"/>
</div>
            </field>
        </record>
    </data>
</odoo>
