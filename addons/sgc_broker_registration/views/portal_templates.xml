<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shared step indicator -->
    <template id="broker_steps" name="Broker registration steps">
        <ol class="list-inline small text-muted mb-4">
            <li class="list-inline-item"><span t-attf-class="badge #{'text-bg-primary' if step == 1 else 'text-bg-secondary'}">1</span> Verify email</li>
            <li class="list-inline-item"><span t-attf-class="badge #{'text-bg-primary' if step == 2 else 'text-bg-secondary'}">2</span> Application &amp; documents</li>
            <li class="list-inline-item"><span t-attf-class="badge #{'text-bg-primary' if step == 3 else 'text-bg-secondary'}">3</span> Review</li>
            <li class="list-inline-item"><span t-attf-class="badge #{'text-bg-primary' if step == 4 else 'text-bg-secondary'}">4</span> Confirmation</li>
        </ol>
    </template>

    <!-- 0. Email capture -->
    <template id="register_page" name="Broker registration">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5" style="max-width: 640px;">
                    <h1 class="mb-1">Broker Registration</h1>
                    <p class="text-muted">Register as a real estate broker or brokerage company. First we verify your
                        email address, then you complete your application, upload the compliance documents and submit.</p>
                    <div class="alert alert-secondary small" role="note">Applications are reviewed by our compliance team. You become a registered broker only after approval.
                        <a href="/broker/resume">Already applied? Continue here</a>.</div>
                    <t t-call="sgc_broker_registration.broker_steps"><t t-set="step" t-value="1"/></t>
                    <div t-if="error" class="alert alert-danger" role="alert"><t t-out="error"/></div>
                    <form action="/broker/register/submit" method="post" class="row g-3">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div style="position:absolute; left:-9999px;" aria-hidden="true">
                            <input type="text" name="website_hp" tabindex="-1" autocomplete="off"/>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="email">Email Address *</label>
                            <input type="email" name="email" id="email" class="form-control form-control-lg" required="required"
                                   t-att-value="values.get('email')" maxlength="200" autofocus="autofocus"/>
                            <div class="form-text">We will send a one-time verification code to this address.</div>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary btn-lg">Send Verification Code</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <template id="already_registered_page" name="Broker already registered">
        <t t-call="website.layout">
            <div id="wrap"><div class="container py-5" style="max-width: 640px;">
                <h2>Check your inbox</h2>
                <p>If this email address has a registration in progress, we have sent a message to it with the
                    link to continue. If you do not receive it within a few minutes, check your spam folder.</p>
            </div></div>
        </t>
    </template>

    <!-- 1. Verify -->
    <template id="verify_page" name="Verify email">
        <t t-call="website.layout">
            <div id="wrap"><div class="container py-5" style="max-width: 560px;">
                <h2>Verify your email</h2>
                <t t-call="sgc_broker_registration.broker_steps"><t t-set="step" t-value="1"/></t>
                <p>We sent a 6-digit code to <strong t-out="app.email"/>. It is valid for 10 minutes.</p>
                <div t-if="error" class="alert alert-danger" role="alert"><t t-out="error"/></div>
                <div t-if="info" class="alert alert-success" role="status"><t t-out="info"/></div>
                <form t-attf-action="/broker/verify/#{app.access_token}/check" method="post" class="mb-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <label class="form-label" for="code">Verification code</label>
                    <input type="text" name="code" id="code" class="form-control form-control-lg text-center"
                           inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code"
                           required="required" autofocus="autofocus" style="letter-spacing: 8px;"/>
                    <button type="submit" class="btn btn-primary mt-3">Verify Email</button>
                </form>
                <form t-attf-action="/broker/verify/#{app.access_token}/resend" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button type="submit" class="btn btn-link p-0">Resend Code</button>
                </form>
            </div></div>
        </t>
    </template>

    <!-- 2. Application -->
    <template id="application_page" name="Broker application">
        <t t-call="website.layout">
            <div id="wrap"><div class="container py-5" style="max-width: 960px;">
                <h1 class="mb-1">Application <t t-out="app.name"/></h1>
                <p class="text-muted">
                    <t t-out="app.company_name or app.full_name"/> - <t t-out="emirates.get(app.emirate)"/> -
                    Status: <span class="badge text-bg-info" t-out="dict(app._fields['state'].selection).get(app.state)"/>
                </p>
                <t t-call="sgc_broker_registration.broker_steps"><t t-set="step" t-value="2"/></t>
                <div t-if="error" class="alert alert-danger" role="alert" style="white-space: pre-line;"><t t-out="error"/></div>
                <div t-if="info" class="alert alert-success" role="status"><t t-out="info"/></div>
                <div t-if="app.state == 'needs_info' and app.review_note" class="alert alert-warning">
                    <strong>Action needed:</strong> <t t-out="app.review_note"/>
                </div>
                <div t-if="app.state == 'approved'" class="alert alert-success">
                    Your registration is approved. Thank you.
                    <div t-if="app.agreement_expiry" class="mt-2">
                        Your brokerage agreement is valid until <strong t-out="app.agreement_expiry"/>.
                        <a class="btn btn-sm btn-success ms-2"
                           t-attf-href="/broker/application/#{app.access_token}/agreement">Download your agreement</a>
                    </div>
                </div>
                <div t-if="app.state == 'rejected'" class="alert alert-danger">
                    Your application was not approved. <t t-out="app.review_note"/>
                </div>
                <div t-if="app.state in ('submitted', 'in_review')" class="alert alert-info">
                    Your application is with our compliance team. You will be notified by email.
                </div>

                <!-- Details -->
                <h3 class="mt-4">1. Applicant / Broker information</h3>
                <form t-attf-action="/broker/application/#{app.access_token}/details" method="post" class="row g-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <fieldset class="row g-3 m-0 p-0" t-att-disabled="None if can_edit else 'disabled'">
                        <div class="col-md-6">
                            <label class="form-label">I am registering as *</label>
                            <select name="applicant_type" class="form-select">
                                <option value="company" t-att-selected="app.applicant_type == 'company'">A brokerage company</option>
                                <option value="individual" t-att-selected="app.applicant_type == 'individual'">An individual broker</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Regulator / Emirate *</label>
                            <select name="emirate" class="form-select">
                                <option value="">Select...</option>
                                <t t-foreach="emirates.items()" t-as="em">
                                    <option t-att-value="em[0]" t-att-selected="app.emirate == em[0]"><t t-out="em[1]"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="col-md-6" t-if="app.applicant_type == 'company'">
                            <label class="form-label">Company / trade name</label>
                            <input type="text" name="company_name" class="form-control" t-att-value="app.company_name"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Full name</label>
                            <input type="text" name="full_name" class="form-control" t-att-value="app.full_name"/>
                        </div>
                        <div class="col-md-4"><label class="form-label">Mobile</label>
                            <input type="tel" name="phone" class="form-control" t-att-value="app.phone"/></div>
                        <div class="col-md-4">
                            <label class="form-label">Nationality</label>
                            <select name="nationality_id" class="form-select">
                                <option value="">Select...</option>
                                <t t-foreach="countries" t-as="c">
                                    <option t-att-value="c.id" t-att-selected="app.nationality_id.id == c.id"><t t-out="c.name"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="col-md-4"><label class="form-label">Emirates ID * (784-YYYY-NNNNNNN-C)</label>
                            <input type="text" name="emirates_id" class="form-control" t-att-value="app.emirates_id"/></div>
                        <div class="col-md-4" t-if="app.applicant_type == 'individual'"><label class="form-label">Passport no. *</label>
                            <input type="text" name="passport_no" class="form-control" t-att-value="app.passport_no"/></div>
                        <t t-if="app.applicant_type == 'company'">
                            <div class="col-md-4"><label class="form-label">Trade licence no. *</label>
                                <input type="text" name="trade_license_no" class="form-control" t-att-value="app.trade_license_no"/></div>
                            <div class="col-md-4"><label class="form-label">Licensing authority</label>
                                <input type="text" name="trade_license_authority" class="form-control" t-att-value="app.trade_license_authority"/></div>
                            <div class="col-md-4"><label class="form-label">Licence issue date</label>
                                <input type="date" name="trade_license_issue_date" class="form-control" t-att-value="app.trade_license_issue_date"/></div>
                            <div class="col-md-4"><label class="form-label">Licence expiry date *</label>
                                <input type="date" name="trade_license_expiry" class="form-control" t-att-value="app.trade_license_expiry"/></div>
                            <div class="col-md-4"><label class="form-label">Brokerage office no. (ORN) *</label>
                                <input type="text" name="orn" class="form-control" t-att-value="app.orn"/></div>
                            <div class="col-md-4"><label class="form-label">Authorised signatory *</label>
                                <input type="text" name="signatory_name" class="form-control" t-att-value="app.signatory_name"/></div>
                            <div class="col-md-4"><label class="form-label">Signatory title</label>
                                <input type="text" name="signatory_title" class="form-control" t-att-value="app.signatory_title"/></div>
                            <div class="col-md-4"><label class="form-label">goAML registration ID</label>
                                <input type="text" name="goaml_id" class="form-control" t-att-value="app.goaml_id"/></div>
                        </t>
                        <t t-if="app.applicant_type == 'individual'">
                            <div class="col-md-4"><label class="form-label">Broker registration no. (BRN) *</label>
                                <input type="text" name="brn" class="form-control" t-att-value="app.brn"/></div>
                        </t>
                        <div class="col-md-4"><label class="form-label">Regulator card / registration expiry</label>
                            <input type="date" name="regulator_expiry" class="form-control" t-att-value="app.regulator_expiry"/></div>
                        <div class="col-md-4"><label class="form-label">VAT TRN (15 digits)</label>
                            <input type="text" name="vat_trn" class="form-control" t-att-value="app.vat_trn"/></div>
                        <div class="col-md-6"><label class="form-label">Office address</label>
                            <input type="text" name="street" class="form-control" t-att-value="app.street"/></div>
                        <div class="col-md-3"><label class="form-label">City</label>
                            <input type="text" name="city" class="form-control" t-att-value="app.city"/></div>
                        <div class="col-md-3"><label class="form-label">P.O. Box</label>
                            <input type="text" name="po_box" class="form-control" t-att-value="app.po_box"/></div>
                        <div class="col-md-4"><label class="form-label">Bank name</label>
                            <input type="text" name="bank_name" class="form-control" t-att-value="app.bank_name"/></div>
                        <div class="col-md-4"><label class="form-label">IBAN (AE + 21 digits)</label>
                            <input type="text" name="iban" class="form-control" t-att-value="app.iban"/></div>
                        <div class="col-md-4"><label class="form-label">Account holder</label>
                            <input type="text" name="account_holder" class="form-control" t-att-value="app.account_holder"/></div>
                        <div class="col-12" t-if="can_edit">
                            <button type="submit" class="btn btn-outline-primary">Save details</button>
                        </div>
                    </fieldset>
                </form>

                <!-- Documents -->
                <h3 class="mt-5">2. Compliance documents</h3>
                <p class="text-muted">PDF, JPG or PNG, up to <t t-out="max_mb"/> MB each. Documents marked
                    <span class="text-danger">*</span> are required.</p>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th>Document</th><th>Uploaded</th><th style="min-width: 320px;">Upload</th></tr></thead>
                        <tbody>
                            <t t-foreach="types" t-as="dt">
                                <tr>
                                    <td>
                                        <strong t-out="dt.name"/> <span t-if="dt.required" class="text-danger">*</span>
                                        <div class="small text-muted" t-out="dt.description"/>
                                        <a t-if="dt.is_agreement" class="small"
                                           t-attf-href="/broker/application/#{app.access_token}/agreement" target="_blank">Download agreement to sign</a>
                                    </td>
                                    <td>
                                        <t t-foreach="docs_by_type.get(dt.id, [])" t-as="d">
                                            <div>
                                                <a t-attf-href="/broker/application/#{app.access_token}/document/#{d.id}" t-out="d.filename"/>
                                                <span t-attf-class="badge #{'text-bg-success' if d.state == 'accepted' else ('text-bg-danger' if d.state == 'rejected' else 'text-bg-secondary')}"
                                                      t-out="dict(d._fields['state'].selection).get(d.state)"/>
                                                <span t-if="d.expiry_date" class="small text-muted">exp. <t t-out="d.expiry_date"/></span>
                                                <div t-if="d.remarks" class="small text-danger" t-out="d.remarks"/>
                                                <form t-if="can_edit and d.state != 'accepted'" method="post" class="d-inline"
                                                      t-attf-action="/broker/application/#{app.access_token}/delete/#{d.id}">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <button type="submit" class="btn btn-link btn-sm text-danger p-0">remove</button>
                                                </form>
                                            </div>
                                        </t>
                                        <span t-if="not docs_by_type.get(dt.id)" class="text-muted">-</span>
                                    </td>
                                    <td>
                                        <form t-if="can_edit" method="post" enctype="multipart/form-data"
                                              t-attf-action="/broker/application/#{app.access_token}/upload" class="row g-1">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="type_id" t-att-value="dt.id"/>
                                            <div class="col-12"><input type="file" name="file" class="form-control form-control-sm"
                                                   accept=".pdf,.jpg,.jpeg,.png" required="required"/></div>
                                            <t t-if="dt.has_expiry">
                                                <div class="col-6"><input type="date" name="issue_date" class="form-control form-control-sm" title="Issue date"/></div>
                                                <div class="col-6"><input type="date" name="expiry_date" class="form-control form-control-sm" title="Expiry date" required="required"/></div>
                                            </t>
                                            <div class="col-12"><button type="submit" class="btn btn-sm btn-outline-primary">Upload</button></div>
                                        </form>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <div t-if="app.missing_type_ids and can_edit" class="alert alert-warning">
                    Still missing: <t t-out="', '.join(app.missing_type_ids.mapped('name'))"/>
                </div>

                <!-- Review -->
                <t t-if="can_edit">
                    <h3 class="mt-5">3. Review and submit</h3>
                    <p class="text-muted">When everything is complete, open the review screen to check your information
                        and documents before submitting.</p>
                    <a t-attf-href="/broker/application/#{app.access_token}/review" class="btn btn-primary btn-lg">Review Application</a>
                </t>
            </div></div>
        </t>
    </template>

    <!-- 3. Review -->
    <template id="review_page" name="Review application">
        <t t-call="website.layout">
            <div id="wrap"><div class="container py-5" style="max-width: 960px;">
                <h1 class="mb-1">Review your application</h1>
                <p class="text-muted">Application <t t-out="app.name"/> - <t t-out="app.company_name or app.full_name"/></p>
                <t t-call="sgc_broker_registration.broker_steps"><t t-set="step" t-value="3"/></t>
                <div t-if="error" class="alert alert-danger" role="alert" style="white-space: pre-line;"><t t-out="error"/></div>

                <h3 class="mt-4">Application information</h3>
                <table class="table table-borderless table-sm" style="max-width: 720px;">
                    <tr><th>Applicant type</th><td><t t-out="dict(app._fields['applicant_type'].selection).get(app.applicant_type)"/></td></tr>
                    <tr><th>Regulator / Emirate</th><td><t t-out="emirates.get(app.emirate)"/></td></tr>
                    <tr t-if="app.company_name"><th>Company / trade name</th><td><t t-out="app.company_name"/></td></tr>
                    <tr><th>Full name</th><td><t t-out="app.full_name"/></td></tr>
                    <tr><th>Email</th><td><t t-out="app.email"/></td></tr>
                    <tr><th>Mobile</th><td><t t-out="app.phone"/></td></tr>
                    <tr><th>Trade licence no.</th><td><t t-out="app.trade_license_no or '-'"/></td></tr>
                    <tr><th>Licensing authority</th><td><t t-out="app.trade_license_authority or '-'"/></td></tr>
                    <tr><th>Licence expiry</th><td><t t-out="app.trade_license_expiry or '-'"/></td></tr>
                    <tr><th>ORN</th><td><t t-out="app.orn or '-'"/></td></tr>
                    <tr><th>BRN</th><td><t t-out="app.brn or '-'"/></td></tr>
                    <tr><th>Regulator expiry</th><td><t t-out="app.regulator_expiry or '-'"/></td></tr>
                    <tr><th>Emirates ID</th><td><t t-out="app.emirates_id or '-'"/></td></tr>
                    <tr><th>Passport no.</th><td><t t-out="app.passport_no or '-'"/></td></tr>
                    <tr><th>Authorised signatory</th><td><t t-out="app.signatory_name or '-'"/></td></tr>
                    <tr><th>VAT TRN</th><td><t t-out="app.vat_trn or '-'"/></td></tr>
                    <tr><th>goAML ID</th><td><t t-out="app.goaml_id or '-'"/></td></tr>
                    <tr><th>Office address</th><td><t t-out="app.street or '-'"/>, <t t-out="app.city or '-'"/></td></tr>
                    <tr><th>Bank / IBAN</th><td><t t-out="app.bank_name or '-'"/> / <t t-out="app.iban or '-'"/></td></tr>
                </table>

                <h3 class="mt-4">Documents</h3>
                <table class="table align-middle">
                    <thead><tr><th>Document</th><th>File</th><th>Status</th><th>Expiry</th></tr></thead>
                    <tbody>
                        <t t-foreach="types" t-as="dt">
                            <t t-foreach="docs_by_type.get(dt.id, [])" t-as="d">
                                <tr>
                                    <td><t t-out="dt.name"/></td>
                                    <td><t t-out="d.filename"/></td>
                                    <td><span t-attf-class="badge #{'text-bg-success' if d.state == 'accepted' else ('text-bg-danger' if d.state == 'rejected' else 'text-bg-secondary')}"
                                              t-out="dict(d._fields['state'].selection).get(d.state)"/></td>
                                    <td><t t-out="d.expiry_date or '-'"/></td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <h3 class="mt-4">Verification</h3>
                <p><strong class="text-success">&#10003; Email Verified</strong>
                   <span class="text-muted small"> (<t t-out="app.verified_at"/>)</span></p>

                <div class="alert alert-info">
                    Please review your information and documents carefully before submitting your application.
                </div>

                <form t-attf-action="/broker/application/#{app.access_token}/submit" method="post" class="mt-4">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="accept_terms" id="accept_terms" value="1" t-att-checked="app.accept_terms"/>
                        <label class="form-check-label" for="accept_terms">I have read and accept the brokerage agreement and I am authorised to bind the broker.</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="accept_aml" id="accept_aml" value="1" t-att-checked="app.accept_aml"/>
                        <label class="form-check-label" for="accept_aml">I confirm compliance with UAE anti-money-laundering and sanctions rules, including goAML registration, and that no owner or signatory is subject to sanctions.</label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="accept_accuracy" id="accept_accuracy" value="1" t-att-checked="app.accept_accuracy"/>
                        <label class="form-check-label" for="accept_accuracy">All information and documents provided are true, complete and valid.</label>
                    </div>
                    <div class="mb-3" style="max-width: 420px;">
                        <label class="form-label" for="declared_name">Type your full name as your electronic signature *</label>
                        <input type="text" name="declared_name" id="declared_name" class="form-control" t-att-value="app.declared_name" required="required"/>
                    </div>
                    <a t-attf-href="/broker/application/#{app.access_token}" class="btn btn-outline-secondary me-2">Back &amp; Edit</a>
                    <button type="submit" class="btn btn-primary btn-lg">Submit Application</button>
                </form>
            </div></div>
        </t>
    </template>

    <!-- 4. Confirmation -->
    <template id="thanks_page" name="Application submitted">
        <t t-call="website.layout">
            <div id="wrap"><div class="container py-5" style="max-width: 720px;">
                <t t-call="sgc_broker_registration.broker_steps"><t t-set="step" t-value="4"/></t>
                <h1 class="mb-3">Application Successfully Submitted</h1>
                <p class="lead">Thank you. Your broker registration application has been successfully received.</p>
                <div class="alert alert-success" style="font-size: 1.1rem;">
                    <strong>Reference Number:</strong> <t t-out="app.name"/>
                </div>
                <p><strong>Estimated Review Time: Up to 48 hours</strong></p>
                <p>Our team will review your application and submitted documents. You will be contacted using the
                    registered contact details once the review is completed.</p>
                <a t-attf-href="/broker/application/#{app.access_token}" class="btn btn-outline-primary">View application status</a>
            </div></div>
        </t>
    </template>
</odoo>
