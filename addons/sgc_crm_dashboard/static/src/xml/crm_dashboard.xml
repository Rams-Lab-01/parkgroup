<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="sgc_crm_dashboard.Dashboard">
    <div class="o_crm_dashboard d-flex flex-column h-100 overflow-auto" t-att-class="{ o_tv: state.tv }" t-att-data-rev="state.rev" t-ref="root">
        <t t-if="state.loading">
            <div class="d-flex justify-content-center align-items-center h-100">
                <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
            </div>
        </t>
        <t t-else="">

            <!-- Header + filters -->
            <div class="d-flex justify-content-between align-items-center mb-3 px-3 flex-wrap gap-2">
                <h4 class="mb-0 fw-bold">
                    <t t-if="state.isAdmin and !state.selectedUserId">CRM Dashboard — All Users</t>
                    <t t-elif="state.isAdmin and state.selectedUserId">CRM Dashboard — <t t-esc="state.allUsers.find(u => u.id === state.selectedUserId)?.name || 'User'"/></t>
                    <t t-else="">My Pipeline</t>
                </h4>
                <div class="d-flex align-items-center gap-2 o_dash_filter">
                    <span class="o_live"><span class="o_live_dot"/>LIVE</span>
                    <button class="btn btn-sm btn-outline-light" t-on-click="toggleTv" title="Fullscreen wallboard: auto-refresh, auto-scroll and news ticker">
                        <i t-attf-class="fa {{state.tv ? 'fa-compress' : 'fa-television'}} me-1"/><t t-esc="state.tv ? 'Exit Screen' : 'Screen Mode'"/>
                    </button>
                    <label class="small fw-semibold">Date Range:</label>
                    <select class="form-select form-select-sm" t-on-change="onDateRangeChange" t-att-value="state.selectedDateRange">
                        <option value="all">All Time</option>
                        <option value="today">Today</option>
                        <option value="7d">Last 7 Days</option>
                        <option value="30d" selected="selected">Last 30 Days</option>
                        <option value="90d">Last 90 Days</option>
                        <option value="6m">Last 6 Months</option>
                        <option value="12m">Last 12 Months</option>
                        <option value="custom">Custom Range...</option>
                    </select>
                    <t t-if="state.isAdmin and !state.selectedUserId">
                        <label class="small fw-semibold">Filter by:</label>
                        <select class="form-select form-select-sm" t-on-change="onFilterChange">
                            <option value="">All Users</option>
                            <t t-foreach="state.allUsers" t-as="u" t-key="u.id">
                                <option t-att-value="u.id" t-att-selected="state.selectedUserId === u.id ? 'selected' : undefined" t-esc="u.name"/>
                            </t>
                        </select>
                    </t>
                </div>
            </div>

            <!-- Custom date range -->
            <div t-if="state.selectedDateRange === 'custom'" class="mx-3 o_custom_range_panel mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-semibold">Custom Date Range</h6>
                    <button class="btn btn-sm btn-link" t-on-click="() => this.onDateRangeChange({ target: { value: '30d' } })"><i class="fa fa-times"/> Close</button>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="small fw-semibold">From</label>
                            <input type="date" class="form-control form-control-sm" id="date_range_from" t-on-change="() => this.onCustomDateRangeChange('from')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="small fw-semibold">To</label>
                            <input type="date" class="form-control form-control-sm" id="date_range_to" t-on-change="() => this.onCustomDateRangeChange('to')"/>
                        </div>
                        <div class="col-md-12">
                            <button class="btn btn-sm btn-primary" t-on-click="() => this.onCustomDateRangeApply()">Apply Custom Range</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Salesperson detail -->
            <div t-if="state.selectedSalesperson" class="mx-3 o_detail_panel mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">
                        <i class="fa fa-user-circle me-2" style="color:#C7A23A;"/>
                        <t t-esc="state.salesperson?.find(p => p.id === state.selectedSalesperson)?.name || 'Salesperson'"/>
                    </h5>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="closeDetail"><i class="fa fa-times"/> Close</button>
                </div>
                <div class="card-body">
                    <div t-if="state.detailLoading" class="text-center py-3"><div class="spinner-border spinner-border-sm"/></div>
                    <t t-if="!state.detailLoading and state.salespersonDetail">
                        <div class="o_kpi_grid o_kpi_grid_4 mb-3">
                            <div t-foreach="detailCards" t-as="c" t-key="c.label" class="o_stat_box o_stat-muted">
                                <div class="o_stat_value" t-esc="c.value"/>
                                <div class="o_stat_label" t-esc="c.label"/>
                            </div>
                        </div>
                        <div class="o_chart_grid">
                            <div>
                                <h6 class="fw-semibold mb-2">Activity Types</h6>
                                <div t-if="!state.salespersonDetail.activity_types.length" class="small" style="opacity:0.5;">No activities recorded</div>
                                <div t-foreach="state.salespersonDetail.activity_types" t-as="at" t-key="at.type" class="d-flex justify-content-between align-items-center o_activity_type_row">
                                    <span t-esc="at.type"/>
                                    <span>
                                        <span class="badge bg-success-subtle" t-esc="at.done + ' done'"/>
                                        <span class="badge bg-secondary-subtle ms-1" t-esc="at.total + ' total'"/>
                                    </span>
                                </div>
                            </div>
                            <div>
                                <h6 class="fw-semibold mb-2">Recent Leads</h6>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead><tr><th>Lead</th><th>Created</th><th>Stage</th><th class="text-center">Prob %</th></tr></thead>
                                        <tbody>
                                            <tr t-foreach="state.salespersonDetail.recent_leads" t-as="l" t-key="l_index">
                                                <td class="fw-medium" t-esc="l.name.length > 40 ? l.name.substring(0,40) + '...' : l.name"/>
                                                <td t-esc="l.create_date"/>
                                                <td><span class="badge bg-light" t-esc="l.stage"/></td>
                                                <td class="text-center" t-esc="l.probability + '%'"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- KPI rows: 6 uniform cards each -->
            <t t-foreach="[['Sales Performance', salesCards], ['Efficiency &amp; Collections', opsCards], ['Developer &amp; Inventory', propertyCards]]" t-as="row" t-key="row[0]">
                <div class="o_section_title px-3" t-esc="row[0]"/>
                <div class="o_kpi_grid px-3 mb-4">
                    <div t-foreach="row[1]" t-as="c" t-key="c.label"
                         class="card o_kpi_card"
                         t-att-class="{ o_kpi_clickable: c.kind }"
                         t-att-role="c.kind ? 'button' : undefined" t-att-tabindex="c.kind ? 0 : undefined"
                         t-attf-style="border-left:4px solid {{c.color}} !important;"
                         t-on-click="() => c.kind and this.openRecords(c.kind)"
                         t-on-keydown="(ev) => c.kind and this.onClickableKeydown(ev, c.kind)">
                        <div class="card-body">
                            <div class="o_kpi_icon" t-attf-style="background:{{c.color}}26;"><i t-attf-class="fa {{c.icon}}" t-attf-style="color:{{c.color}};"/></div>
                            <div class="o_kpi_text">
                                <div class="o_kpi_label" t-esc="c.label"/>
                                <div class="o_kpi_value" t-esc="c.value"/>
                                <div class="o_kpi_sublabel" t-esc="c.sub || ''"/>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

            <!-- Projects: inventory + sales/collections per project -->
            <div class="o_section_title px-3">Projects</div>
            <div class="o_chart_grid px-3 mb-4">
                <div class="card o_dash_card">
                    <div class="card-header">
                        <h6><i class="fa fa-building me-2"/>Inventory by Project</h6>
                        <small>Sold vs available units per project.</small>
                    </div>
                    <div class="card-body o_chart_body">
                        <canvas t-if="state.property.projects.length" t-ref="projectChart"/>
                        <div t-else="" class="o_chart_empty"><i class="fa fa-info-circle fa-2x mb-2"/><div class="small">No project inventory.</div></div>
                    </div>
                </div>
                <div class="card o_dash_card">
                    <div class="card-header">
                        <h6><i class="fa fa-money me-2"/>Sales vs Collected by Project</h6>
                        <small>Contract value against cash collected (AED).</small>
                    </div>
                    <div class="card-body o_chart_body">
                        <canvas t-if="state.property.projects.length" t-ref="projectSalesChart"/>
                        <div t-else="" class="o_chart_empty"><i class="fa fa-info-circle fa-2x mb-2"/><div class="small">No sales yet.</div></div>
                    </div>
                </div>
            </div>

            <!-- Rankings: brokers and RMs, same booked-value basis -->
            <div class="o_section_title px-3">Rankings</div>
            <div class="o_chart_grid px-3 mb-4">
                <t t-foreach="[['Broker Ranking', 'fa-handshake-o', state.property.brokers], ['RM Ranking', 'fa-user', state.property.rms]]" t-as="rk" t-key="rk[0]">
                    <div class="card o_dash_card">
                        <div class="card-header">
                            <h6><i t-attf-class="fa {{rk[1]}} me-2"/><t t-esc="rk[0]"/></h6>
                            <small>Top 10 by contract value in the selected period (cancelled excluded).</small>
                        </div>
                        <div class="card-body p-0 o_chart_body o_lb_scroll">
                            <table t-if="rk[2].length" class="table table-hover align-middle mb-0">
                                <thead><tr><th class="ps-3">#</th><th>Name</th><th class="text-center">Deals</th><th class="text-center">Confirmed</th><th class="text-end pe-3">Value (AED)</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="rk[2]" t-as="r" t-key="r.id">
                                        <td class="ps-3" t-esc="r.rank"/>
                                        <td class="fw-medium" t-esc="r.name"/>
                                        <td class="text-center" t-esc="r.deals"/>
                                        <td class="text-center" t-esc="r.confirmed"/>
                                        <td class="text-end pe-3" t-esc="formatAbbrev(r.value)"/>
                                    </tr>
                                </tbody>
                            </table>
                            <div t-else="" class="o_chart_empty"><div class="small">No bookings in this period.</div></div>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Charts: always two per row, identical card height -->
            <div class="o_section_title px-3">Pipeline</div>
            <div class="o_chart_grid px-3 mb-4">
                <div class="card o_dash_card">
                    <div class="card-header">
                        <h6><i class="fa fa-filter me-2"/>Conversion Funnel</h6>
                        <small>Leads per stage (all-time). Click a bar to view them.</small>
                    </div>
                    <div class="card-body o_chart_body"><canvas t-ref="funnelChart"/></div>
                </div>
                <div class="card o_dash_card">
                    <div class="card-header">
                        <h6><i class="fa fa-bar-chart me-2"/>Pipeline Movement (6 months)</h6>
                        <small>Created vs won vs lost per month. Click a bar to view them.</small>
                    </div>
                    <div class="card-body o_chart_body"><canvas t-ref="monthlyChart"/></div>
                </div>
                <div class="card o_dash_card">
                    <div class="card-header">
                        <h6><i class="fa fa-hourglass-half me-2"/>Pipeline Aging</h6>
                        <small>Open leads by age — red = rotting. Click a bar to view them.</small>
                    </div>
                    <div class="card-body o_chart_body"><canvas t-ref="agingChart"/></div>
                </div>
                <div class="card o_dash_card">
                    <div class="card-header">
                        <h6><i class="fa fa-users me-2"/>Pipeline by Owner</h6>
                        <small>Open leads per salesperson — flags concentration risk.</small>
                    </div>
                    <div class="card-body o_chart_body">
                        <canvas t-if="state.owner_pipeline.length" t-ref="ownerChart"/>
                        <div t-else="" class="o_chart_empty"><i class="fa fa-info-circle fa-2x mb-2"/><div class="small">No leads assigned to salespeople.</div></div>
                    </div>
                </div>
            </div>

            <div class="o_section_title px-3">Lead Sources</div>
            <div class="o_chart_grid px-3 mb-4">
                <div class="card o_dash_card">
                    <div class="card-header">
                        <h6><i class="fa fa-pie-chart me-2"/>Lead Volume by Source</h6>
                        <small>Where open leads come from. Click a slice to view them.</small>
                    </div>
                    <div class="card-body o_chart_body">
                        <canvas t-if="state.pipeline_by_source.length" t-ref="sourceChart"/>
                        <div t-else="" class="o_chart_empty"><i class="fa fa-info-circle fa-2x mb-2"/><div class="small">No UTM source on open leads.<br/>Populate campaign tracking.</div></div>
                    </div>
                </div>
                <div class="card o_dash_card">
                    <div class="card-header">
                        <h6><i class="fa fa-percent me-2"/>Source Conversion Rate</h6>
                        <small>Won ÷ total leads per source — your highest-ROI channels.</small>
                    </div>
                    <div class="card-body o_chart_body">
                        <canvas t-if="state.kpi.source_conversion and state.kpi.source_conversion.length" t-ref="sourceConversionChart"/>
                        <div t-else="" class="o_chart_empty"><i class="fa fa-info-circle fa-2x mb-2"/><div class="small">No conversion data yet.</div></div>
                    </div>
                </div>
            </div>

            <!-- Qualification (only when sgc_sales_playbook is installed) -->
            <t t-if="state.qualification.enabled">
                <div class="o_section_title px-3">Qualification &amp; Gate Compliance</div>
                <div class="o_kpi_grid o_kpi_grid_4 px-3 mb-4">
                    <div t-foreach="qualTiles" t-as="c" t-key="c.label" class="o_stat_box o_stat-muted o_stat_clickable" role="button" tabindex="0"
                         t-on-click="() => this.openRecords(c.kind)" t-on-keydown="(ev) => this.onClickableKeydown(ev, c.kind)">
                        <div class="o_stat_value" t-esc="c.value"/>
                        <div class="o_stat_label" t-esc="c.label"/>
                        <div class="small text-muted" style="font-size:0.65rem;" t-esc="c.sub || ''"/>
                    </div>
                </div>
            </t>

            <!-- Salesperson performance -->
            <div class="o_section_title px-3">Team</div>
            <div class="o_chart_grid px-3 pb-4">
                <div class="card o_dash_card o_lb_panel" role="button" tabindex="0"
                     t-on-click="() => this.openLeaderboard()" t-on-keydown="(ev) => this.onLeaderboardKeydown(ev)">
                    <div class="card-header">
                        <h6><i class="fa fa-trophy me-2"/>Leaderboard</h6>
                        <small>Ranked by meetings booked &amp; proposal pipeline. Click for the full board.</small>
                    </div>
                    <div class="card-body o_chart_body o_lb_scroll">
                        <div class="o_lb_panel_colheads" t-if="state.leaderboard.top.length">
                            <span/><span/><span>Rep</span><span class="text-center">Mtgs</span><span class="text-end">Pipeline</span><span class="text-end">Score</span>
                        </div>
                        <ol class="o_lb_panel_list" t-if="state.leaderboard.top.length">
                            <li t-foreach="state.leaderboard.top" t-as="row" t-key="row.id"
                                class="o_lb_panel_row" t-att-class="{ o_lb_panel_me: row.id === state.currentUserId }"
                                t-att-data-rank="row.rank &lt;= 3 ? row.rank : ''">
                                <span class="o_lb_panel_rank" t-att-data-rank="row.rank">
                                    <t t-if="row.rank === 1">🥇</t><t t-elif="row.rank === 2">🥈</t><t t-elif="row.rank === 3">🥉</t><t t-else="" t-esc="row.rank"/>
                                </span>
                                <img class="o_lb_panel_avatar" t-attf-src="/web/image/res.users/{{row.id}}/avatar_128/32x32" t-att-alt="row.name"/>
                                <span class="o_lb_panel_name" t-esc="row.name"/>
                                <span class="o_lb_panel_meetings text-center" t-esc="row.meetings_booked"/>
                                <span class="o_lb_panel_pipeline text-end" t-esc="formatAbbrev(row.pipeline_value)"/>
                                <span class="o_lb_panel_score text-end" t-esc="row.score"/>
                            </li>
                        </ol>
                        <div class="o_lb_panel_me_row" t-if="state.leaderboard.me">
                            <span class="o_lb_panel_rank" t-esc="'#' + state.leaderboard.me.rank"/>
                            <img class="o_lb_panel_avatar" t-attf-src="/web/image/res.users/{{state.leaderboard.me.id}}/avatar_128/32x32" alt="You"/>
                            <span class="o_lb_panel_name">You</span>
                            <span class="o_lb_panel_meetings text-center" t-esc="state.leaderboard.me.meetings_booked"/>
                            <span class="o_lb_panel_pipeline text-end" t-esc="formatAbbrev(state.leaderboard.me.pipeline_value)"/>
                            <span class="o_lb_panel_score text-end" t-esc="state.leaderboard.me.score"/>
                        </div>
                        <div t-if="!state.leaderboard.top.length" class="o_chart_empty"><div class="small">No ranked activity yet</div></div>
                    </div>
                </div>
                <div class="card o_dash_card">
                    <div class="card-header">
                        <h6><i class="fa fa-user me-2"/>Salesperson Performance</h6>
                        <small>Click a row to view individual activity &amp; productivity</small>
                    </div>
                    <div class="card-body p-0 o_chart_body o_lb_scroll">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="ps-3">Salesperson</th>
                                        <th class="text-center">Leads</th>
                                        <th class="text-center">Won</th>
                                        <th class="text-center">Lost</th>
                                        <th class="text-center">Days W/O Booking</th>
                                        <th class="text-center pe-3">Win Rate</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.salesperson" t-as="p" t-key="p.id" t-on-click="selectSalesperson" class="cursor-pointer"
                                        t-attf-data-user-id="{{p.id}}" t-att-class="{ o_row_selected: state.selectedSalesperson === p.id }">
                                        <td class="ps-3"><i class="fa fa-user-circle me-1" style="opacity:0.5;"/><span class="fw-medium" t-esc="p.name"/></td>
                                        <td class="text-center" t-esc="formatNumber(p.leads)"/>
                                        <td class="text-center"><span class="badge rounded-pill bg-success-subtle" t-esc="formatNumber(p.won)"/></td>
                                        <td class="text-center"><span class="badge rounded-pill bg-danger-subtle" t-esc="formatNumber(p.lost)"/></td>
                                        <td class="text-center"><span t-att-style="'color:' + daysColor(p.days_without_booking) + ';'" t-esc="daysLabel(p.days_without_booking)"/></td>
                                        <td class="text-center pe-3" t-esc="p.leads > 0 ? ((p.won / p.leads) * 100).toFixed(1) + '%' : '-'"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div t-if="!state.salesperson.length" class="o_chart_empty"><div class="small">No leads assigned to salespeople yet.</div></div>
                    </div>
                </div>
            </div>

            <!-- News ticker (screen mode only; two copies make the loop seamless) -->
            <div t-if="state.tv and state.ticker.length" class="o_ticker">
                <span class="o_ticker_label"><i class="fa fa-bullhorn me-2"/>LIVE UPDATES</span>
                <div class="o_ticker_view">
                    <div class="o_ticker_track" t-attf-style="animation-duration: {{tickerSeconds}}s;">
                        <t t-foreach="[0, 1]" t-as="copy" t-key="copy">
                            <span t-foreach="state.ticker" t-as="item" t-key="item_index" t-attf-class="o_ticker_item o_ticker_{{item.kind}}">
                                <i t-attf-class="fa {{item.kind === 'win' ? 'fa-trophy' : item.kind === 'alert' ? 'fa-exclamation-triangle' : 'fa-info-circle'}} me-2"/><t t-esc="item.text"/>
                            </span>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </div>
</t>

</templates>
