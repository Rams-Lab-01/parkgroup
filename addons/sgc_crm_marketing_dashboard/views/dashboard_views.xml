<odoo>

    <!-- ── The dashboard board (OWL client action) ── -->
    <record id="action_crm_marketing_dashboard" model="ir.actions.client">
        <field name="name">CRM Dashboard</field>
        <field name="tag">sgc_crm_marketing_dashboard</field>
    </record>

    <menuitem id="menu_crm_marketing_dashboard"
              name="CRM Dashboard"
              parent="crm.crm_menu_root"
              action="action_crm_marketing_dashboard"
              sequence="1"
              groups="sales_team.group_sale_salesman,sales_team.group_sale_manager,base.group_system"/>

    <!-- ── Campaign spend entry (so ROI is fed with real numbers) ── -->
    <record id="view_utm_campaign_list_spend" model="ir.ui.view">
        <field name="name">utm.campaign.list.spend</field>
        <field name="model">utm.campaign</field>
        <field name="arch" type="xml">
            <list string="Campaigns" editable="bottom">
                <field name="name"/>
                <field name="user_id"/>
                <field name="marketing_cost" widget="monetary"/>
                <field name="cost_currency_id" invisible="1"/>
                <field name="color"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_utm_campaign_spend" model="ir.actions.act_window">
        <field name="name">Campaign Spend</field>
        <field name="res_model">utm.campaign</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_utm_campaign_list_spend"/>
    </record>

    <menuitem id="menu_utm_campaign_spend"
              name="Campaign Spend"
              parent="menu_crm_marketing_dashboard"
              action="action_utm_campaign_spend"
              sequence="2"
              groups="sales_team.group_sale_salesman,sales_team.group_sale_manager,base.group_system"/>

</odoo>
