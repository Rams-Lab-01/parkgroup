<odoo>

    <template id="report_escrow_project_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center mb-4">Project Escrow Statement</h2>

                        <table class="table table-bordered mb-4">
                            <tr>
                                <th>Project Name:</th>
                                <td><span t-field="o.name"/></td>
                                <th>Project Code:</th>
                                <td><span t-field="o.code"/></td>
                            </tr>
                            <tr>
                                <th>Escrow Agent:</th>
                                <td><span t-field="o.escrow_agent_id"/></td>
                                <th>Escrow Account Ref:</th>
                                <td><span t-field="o.escrow_account_ref"/></td>
                            </tr>
                            <tr>
                                <th>Certified Progress:</th>
                                <td><span t-field="o.escrow_certified_progress"/>%</td>
                                <th>Retention %:</th>
                                <td><span t-field="o.escrow_retention_pct"/>%</td>
                            </tr>
                        </table>

                        <h4>Financial Position</h4>
                        <table class="table table-striped mb-4">
                            <thead>
                                <tr>
                                    <th>Total Received</th>
                                    <th>Total Released</th>
                                    <th>Current Balance</th>
                                    <th>Releasable Ceiling</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="o.escrow_received_amount"/></td>
                                    <td><span t-field="o.escrow_released_amount"/></td>
                                    <td><span t-field="o.escrow_balance_amount"/></td>
                                    <td><span t-field="o.escrow_releasable_amount"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4>Allocations Summary</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Total Units</th>
                                    <th>Pending Allocations</th>
                                    <th>Flagged Allocations</th>
                                    <th>Required Escrow</th>
                                    <th>Allocated Escrow</th>
                                    <th>Variance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="o.escrow_allocation_count"/></td>
                                    <td><span t-field="o.escrow_allocation_pending_count"/></td>
                                    <td><span t-field="o.escrow_allocation_flag_count"/></td>
                                    <td><span t-field="o.escrow_allocation_required_amount"/></td>
                                    <td><span t-field="o.escrow_allocation_allocated_amount"/></td>
                                    <td><span t-field="o.escrow_allocation_variance_amount"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
