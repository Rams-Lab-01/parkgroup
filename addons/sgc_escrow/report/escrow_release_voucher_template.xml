<odoo>

    <template id="report_escrow_release_voucher">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center mb-4">Escrow Release Voucher</h2>

                        <table class="table table-bordered mb-4">
                            <tr>
                                <th>Release Ref:</th>
                                <td><span t-field="o.name"/></td>
                                <th>Date:</th>
                                <td><span t-field="o.date"/></td>
                            </tr>
                            <tr>
                                <th>Project:</th>
                                <td><span t-field="o.project_id.name"/></td>
                                <th>Operating Journal:</th>
                                <td><span t-field="o.operating_journal_id.name"/></td>
                            </tr>
                            <tr>
                                <th>Bank / RERA Ref:</th>
                                <td><span t-field="o.payment_reference"/></td>
                                <th>Status:</th>
                                <td><span t-field="o.state"/></td>
                            </tr>
                        </table>

                        <h4>Entitlement Snapshots</h4>
                        <table class="table table-striped mb-4">
                            <tr>
                                <th>Certified Progress %</th>
                                <td><span t-field="o.certified_progress_snapshot"/>%</td>
                                <th>Retention %</th>
                                <td><span t-field="o.retention_pct_snapshot"/>%</td>
                            </tr>
                            <tr>
                                <th>Received into Escrow</th>
                                <td><span t-field="o.received_snapshot"/></td>
                                <th>Released Before</th>
                                <td><span t-field="o.released_before_snapshot"/></td>
                            </tr>
                            <tr>
                                <th>Entitled Cumulative</th>
                                <td><span t-field="o.entitled_snapshot"/></td>
                                <th>Releasable Now</th>
                                <td><span t-field="o.releasable_snapshot"/></td>
                            </tr>
                        </table>

                        <div class="card p-3 mb-4 bg-light">
                            <h4>Release Amount Requested: <span t-field="o.amount"/></h4>
                            <t t-if="o.is_override">
                                <p class="text-danger">
                                    <strong>Override Release:</strong> Approved above standard progress entitlement.<br/>
                                    <strong>Reason:</strong> <span t-field="o.override_reason"/>
                                </p>
                            </t>
                        </div>

                        <div class="row mt-5 pt-5 text-center">
                            <div class="col-6">
                                <p>_______________________________</p>
                                <p><strong>Developer Sign-off</strong></p>
                            </div>
                            <div class="col-6">
                                <p>_______________________________</p>
                                <p><strong>Escrow Bank / Agent Sign-off</strong></p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
