<odoo>

    <!-- === Account Move (invoice) === -->
    <record id="view_move_escrow_form" model="ir.ui.view">
        <field name="name">account.move.form.escrow</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Escrow attribution sits under the amount due, where the finance
                 team is already looking when they ask "into which bank?". -->
            <xpath expr="//field[@name='invoice_payment_term_id']" position="after">
                <field name="escrow_project_id"
                       groups="sgc_escrow.group_escrow_user"
                       invisible="not escrow_project_id"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Escrow" name="escrow" groups="sgc_escrow.group_escrow_user">
                    <group>
                        <group>
                            <field name="escrow_project_id"/>
                            <field name="is_escrow_release" invisible="1"/>
                        </group>
                        <group>
                            <field name="escrow_release_id"
                                   invisible="not escrow_release_id"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="not escrow_project_id or not escrow_project_id.escrow_enabled">
                        This project holds escrow. Buyer receipts for this invoice
                        belong in its escrow bank account
                        <field name="escrow_bank_journal_id"
                               class="oe_inline" readonly="1"/>
                        -- the Register Payment wizard pre-selects it.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Journal item list: surface project attribution on the ledger itself -->
    <record id="view_move_line_escrow_tree" model="ir.ui.view">
        <field name="name">account.move.line.tree.escrow</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="escrow_project_id" groups="sgc_escrow.group_escrow_user"
                       optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Payment register wizard: show where the money is being routed -->
    <record id="view_payment_register_escrow_form" model="ir.ui.view">
        <field name="name">account.payment.register.form.escrow</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="escrow_routing_project_id"
                       groups="sgc_escrow.group_escrow_user"
                       invisible="not escrow_routing_project_id"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>