<odoo>

    <!-- Escrow Release List View -->
    <record id="view_escrow_release_tree" model="ir.ui.view">
        <field name="name">escrow.release.list</field>
        <field name="model">escrow.release</field>
        <field name="arch" type="xml">
            <list string="Escrow Releases">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="operating_journal_id"/>
                <field name="certified_progress_snapshot"/>
                <field name="releasable_snapshot"/>
                <field name="amount"/>
                <field name="is_override" widget="boolean_toggle"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-info="state == 'approved'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Escrow Release Form View -->
    <record id="view_escrow_release_form" model="ir.ui.view">
        <field name="name">escrow.release.form</field>
        <field name="model">escrow.release</field>
        <field name="arch" type="xml">
            <form string="Escrow Release">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                            invisible="state != 'draft'" groups="sgc_escrow.group_escrow_approver"/>
                    <button name="action_post" string="Post Release" type="object" class="oe_highlight"
                            invisible="state != 'approved'" groups="sgc_escrow.group_escrow_approver"/>
                    <button name="action_refresh_snapshots" string="Refresh Snapshots" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_print_voucher" string="Print Voucher" type="object"
                            invisible="state in ('draft', 'cancelled')"/>
                    <button name="action_reverse" string="Reverse" type="object"
                            invisible="state != 'posted'" groups="sgc_escrow.group_escrow_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('posted', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Release Details">
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="operating_journal_id" readonly="state != 'draft'"/>
                            <field name="payment_reference" readonly="state in ('posted', 'cancelled')"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Withdrawal Ceiling &amp; Snapshots">
                            <field name="certified_progress_snapshot"/>
                            <field name="retention_pct_snapshot"/>
                            <field name="received_snapshot"/>
                            <field name="released_before_snapshot"/>
                            <field name="entitled_snapshot"/>
                            <field name="releasable_snapshot"/>
                        </group>
                    </group>
                    <group string="Amount &amp; Overrides">
                        <group>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="amount_exceeds_entitlement" invisible="1"/>
                            <field name="remaining_after_release"/>
                        </group>
                        <group>
                            <field name="is_override" readonly="state != 'draft'"/>
                            <field name="override_reason" readonly="state != 'draft'"
                                   required="is_override"/>
                            <field name="override_user_id" readonly="1" invisible="not is_override"/>
                        </group>
                    </group>
                    <group string="Accounting Link" invisible="state in ('draft', 'cancelled')">
                        <group>
                            <field name="journal_entry_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="reversal_entry_id" readonly="1" invisible="not reversal_entry_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes &amp; Attachments" name="notes">
                            <group>
                                <field name="notes" placeholder="Release notes..."/>
                                <field name="progress_evidence" filename="progress_evidence_filename"/>
                                <field name="progress_evidence_filename" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Escrow Release Search View -->
    <record id="view_escrow_release_search" model="ir.ui.view">
        <field name="name">escrow.release.search</field>
        <field name="model">escrow.release</field>
        <field name="arch" type="xml">
            <search string="Search Escrow Releases">
                <field name="name"/>
                <field name="project_id"/>
                <field name="payment_reference"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Override Releases" name="override" domain="[('is_override', '=', True)]"/>
                <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- Escrow Release Action -->
    <record id="action_escrow_release" model="ir.actions.act_window">
        <field name="name">Escrow Releases</field>
        <field name="res_model">escrow.release</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_escrow_release_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a progress-gated escrow release document.
            </p>
            <p>
                Releases draw money from a project escrow account capped by certified construction progress.
            </p>
        </field>
    </record>

</odoo>
