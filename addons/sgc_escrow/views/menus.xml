 Escrow menus. Two entry points on purpose:
 - "Escrow" under the Property Management root, for the property team;
 - "Escrow" under Accounting/Invoicing, for finance.
 Both point at the same records, so nobody has to know which door to use.-->
<odoo>

    <!--Under Property Management-->
    <menuitem id="menu_escroot_property"
              name="Escrow"
              parent="sgc_offplan_rental_property_management.main_menu_rental_management"
              sequence="35"
              groups="sgc_escrow.group_escrow_user"/>

    <menuitem id="menu_escrow_release"
              name="Escrow Releases"
              parent="menu_escroot_property"
              action="action_escrow_release"
              sequence="5"
              groups="sgc_escrow.group_escrow_user"/>

    <menuitem id="menu_escrow_allocation"
              name="Escrow Allocations"
              parent="menu_escroot_property"
              action="action_escrow_allocation"
              sequence="10"
              groups="sgc_escrow.group_escrow_user"/>

    <menuitem id="menu_escrow_statement_project"
              name="Project Escrow Statements"
              parent="menu_escroot_property"
              action="sgc_escrow.action_report_escrow_project_statement"
              sequence="20"
              groups="sgc_escrow.group_escrow_user"/>

    <menuitem id="menu_escrow_allocation_import"
              name="Import Escrow Allocations"
              parent="menu_escroot_property"
              action="action_escrow_allocation_import"
              sequence="90"
              groups="sgc_escrow.group_escrow_manager"/>

    <!--Under Accounting-->
    <menuitem id="menu_escroot_accounting"
              name="Escrow"
              parent="account.menu_finance"
              sequence="95"
              groups="sgc_escrow.group_escrow_user"/>

    <menuitem id="menu_escrow_release_accounting"
              name="Escrow Releases"
              parent="menu_escroot_accounting"
              action="action_escrow_release"
              sequence="5"
              groups="sgc_escrow.group_escrow_approver"/>

    <menuitem id="menu_escrow_allocation_accounting"
              name="Escrow Allocations"
              parent="menu_escroot_accounting"
              action="action_escrow_allocation"
              sequence="10"
              groups="sgc_escrow.group_escrow_user"/>

</odoo>