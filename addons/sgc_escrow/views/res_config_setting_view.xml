<odoo>

    <record id="view_res_config_settings_escrow_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.escrow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="sgc_offplan_rental_property_management.res_config_settings_view_form_rental"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@data-string='Property Management']" position="inside">
                <block title="Escrow" name="escrow_container">
                    <setting id="setting_escrow_policy"
                             string="Escrow Payment Policy"
                             help="What to do when a buyer receipt for an escrow-enabled project is booked to a bank other than that project's escrow account.">
                        <field name="sgc_escrow_payment_policy"/>
                    </setting>
                    <setting id="setting_escrow_retention"
                             string="Default Retention"
                             help="Pre-filled on new project escrow configuration. UAE statutory retention is 5%. Changeable per project.">
                        <div class="content-group mt16">
                            <field name="sgc_escrow_default_retention_pct"/>
                            <span>%</span>
                        </div>
                    </setting>
                    <setting id="setting_escrow_guard_installments"
                             string="Milestone Invoice Guard"
                             help="Reserved for the construction-phase slices (A1). Leave off until payment-plan milestones exist on this database.">
                        <field name="sgc_escrow_guard_installments"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>