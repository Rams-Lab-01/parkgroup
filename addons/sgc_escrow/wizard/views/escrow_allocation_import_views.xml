<odoo>

    <record id="view_escrow_allocation_import_form" model="ir.ui.view">
        <field name="name">escrow.allocation.import.form</field>
        <field name="model">escrow.allocation.import</field>
        <field name="arch" type="xml">
            <form string="Import Escrow Allocations">
                <sheet>
                    <div class="oe_title">
                        <h2>Import Per-Unit Escrow Allocations</h2>
                    </div>
                    <group>
                        <group string="Files">
                            <field name="source_file" filename="source_filename"/>
                            <field name="source_filename" invisible="1"/>
                            <field name="flag_file" filename="flag_filename"/>
                            <field name="flag_filename" invisible="1"/>
                        </group>
                        <group string="Options">
                            <field name="dry_run" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook invisible="state == 'draft'">
                        <page string="Import Summary" name="summary">
                            <group>
                                <field name="created_count"/>
                                <field name="updated_count"/>
                                <field name="skipped_count"/>
                                <field name="flagged_count"/>
                            </group>
                            <field name="report_line_ids" readonly="1">
                                <list string="Import Lines">
                                    <field name="project_label"/>
                                    <field name="unit_label"/>
                                    <field name="client_label"/>
                                    <field name="outcome"/>
                                    <field name="detail"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_run" string="Run Import" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_escrow_allocation_import" model="ir.actions.act_window">
        <field name="name">Import Escrow Allocations</field>
        <field name="res_model">escrow.allocation.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
