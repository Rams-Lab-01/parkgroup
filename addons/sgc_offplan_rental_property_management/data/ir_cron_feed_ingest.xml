<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_process_bayut_feed" model="ir.cron">
        <field name="name">Property Management: Process Bayut XML Feed</field>
        <field name="model_id" ref="sgc_offplan_rental_property_management.model_portal_connector"/>
        <field name="state" eval="'code'"/>
        <field name="code" eval="'model.process_inbound_feeds()'"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="priority">5</field>
        <field name="active" eval="False"/>
    </record>
    <record id="ir_cron_process_dubizzle_feed" model="ir.cron">
        <field name="name">Property Management: Process Dubizzle XML Feed</field>
        <field name="model_id" ref="sgc_offplan_rental_property_management.model_portal_connector"/>
        <field name="state" eval="'code'"/>
        <field name="code" eval="'model.process_inbound_feeds()'"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="priority">5</field>
        <field name="active" eval="False"/>
    </record>
    <record id="ir_cron_process_all_inbound_feeds" model="ir.cron">
        <field name="name">Property Management: Process All Inbound Feeds</field>
        <field name="model_id" ref="sgc_offplan_rental_property_management.model_portal_connector"/>
        <field name="state" eval="'code'"/>
        <field name="code" eval="'model.process_all_inbound_feeds()'"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="priority">5</field>
        <field name="active" eval="True"/>
    </record>
</odoo>