<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="maintenance_contract_report_template">
        <t t-call="web.html_container">
          <t t-foreach="docs" t-as="o">
            <t t-set="company" t-value="o.company_id or env.company"/>
            <t t-set="fd" t-value="lambda d: d.strftime('%d %b %Y') if d else ' - '"/>
            <t t-call="sgc_offplan_rental_property_management.property_report_styles"/>
            <div class="o_pmg_doc article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id"><t t-call="sgc_offplan_rental_property_management.property_report_styles"/>
                <t t-set="report_ref" t-value="o.name or ' - '"/>
                <t t-set="report_date" t-value="fd(datetime.date.today())"/>
                <t t-call="sgc_offplan_rental_property_management.property_report_letterhead"/>
                <t t-set="report_title">Maintenance Contract</t>
                <t t-set="report_subtitle">Annual Maintenance / Service Agreement  -  United Arab Emirates</t>
                <t t-call="sgc_offplan_rental_property_management.property_report_title"/>

                <div class="o_pmg_section o_pmg_keep">
                    <div class="o_pmg_section-heading"><span class="o_pmg_num">1</span>Parties &amp; Property</div>
                    <div class="o_pmg_section-body">
                        <table class="o_pmg_dl">
                            <tr t-if="o.landlord_id"><td class="o_pmg_dl-label">Landlord</td><td class="o_pmg_dl-value" t-out="o.landlord_id.name"/></tr>
                            <tr t-if="o.customer_id"><td class="o_pmg_dl-label">Customer</td><td class="o_pmg_dl-value" t-out="o.customer_id.name"/></tr>
                            <tr t-if="o.tenant_id"><td class="o_pmg_dl-label">Tenant</td><td class="o_pmg_dl-value" t-out="o.tenant_id.name"/></tr>
                            <tr t-if="o.vendor_id"><td class="o_pmg_dl-label">Vendor</td><td class="o_pmg_dl-value" t-out="o.vendor_id.name"/></tr>
                            <tr t-if="o.property_id"><td class="o_pmg_dl-label">Property Covered</td><td class="o_pmg_dl-value" t-out="o.property_id.name"/></tr>
                            <tr t-if="o.property_id and o.property_id.makani_number"><td class="o_pmg_dl-label">Makani Number</td><td class="o_pmg_dl-value" t-out="o.property_id.makani_number"/></tr>
                        </table>
                    </div>
                </div>

                <div class="o_pmg_section o_pmg_keep">
                    <div class="o_pmg_section-heading"><span class="o_pmg_num">2</span>Contract Type &amp; Duration</div>
                    <div class="o_pmg_section-body">
                        <table class="o_pmg_dl">
                            <tr t-if="o.amc_contract_type"><td class="o_pmg_dl-label">Contract Type</td><td class="o_pmg_dl-value" t-out="dict(o._fields['amc_contract_type'].selection).get(o.amc_contract_type, o.amc_contract_type)"/></tr>
                            <tr t-if="o.contract_start_date"><td class="o_pmg_dl-label">Start Date</td><td class="o_pmg_dl-value" t-out="fd(o.contract_start_date)"/></tr>
                            <tr t-if="o.contract_end_date"><td class="o_pmg_dl-label">End Date</td><td class="o_pmg_dl-value" t-out="fd(o.contract_end_date)"/></tr>
                        </table>
                    </div>
                </div>

                <div class="o_pmg_section" t-if="o.scope_of_work">
                    <div class="o_pmg_section-heading"><span class="o_pmg_num">3</span>Scope of Work</div>
                    <div class="o_pmg_section-body">
                        <p style="white-space: pre-line;" t-out="o.scope_of_work"/>
                    </div>
                </div>

                <div class="o_pmg_section o_pmg_keep">
                    <div class="o_pmg_section-heading"><span class="o_pmg_num">4</span>Service Schedule &amp; SLA</div>
                    <div class="o_pmg_section-body">
                        <table class="o_pmg_dl">
                            <tr t-if="o.service_frequency"><td class="o_pmg_dl-label">PPM Visit Frequency</td><td class="o_pmg_dl-value" t-out="o.service_frequency"/></tr>
                            <tr t-if="o.site_supervisor_id"><td class="o_pmg_dl-label">Site Supervisor</td><td class="o_pmg_dl-value" t-out="o.site_supervisor_id.name"/></tr>
                            <tr t-if="o.sla_response_hours"><td class="o_pmg_dl-label">SLA Response Time</td><td class="o_pmg_dl-value" t-out="'%s hour(s)' % o.sla_response_hours"/></tr>
                        </table>
                    </div>
                </div>

                <div class="o_pmg_section">
                    <div class="o_pmg_section-heading"><span class="o_pmg_num">5</span>Product / Service Lines</div>
                    <table class="o_pmg_table">
                        <colgroup>
                            <col style="width:46%;"/><col style="width:12%;"/><col style="width:21%;"/><col style="width:21%;"/>
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Qty</th>
                                <th style="text-align:right;">Unit Price (AED)</th>
                                <th style="text-align:right;">Amount (AED)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.maintenance_product_ids or []" t-as="line">
                                <td t-out="line.description or line.product_id.name or ''"/>
                                <td t-out="line.quantity"/>
                                <td style="text-align:right;" t-out="'{:,.2f}'.format(line.price_unit or 0.0)"/>
                                <td style="text-align:right;" t-out="'{:,.2f}'.format(line.price_subtotal or 0.0)"/>
                            </tr>
                            <tr t-if="not o.maintenance_product_ids">
                                <td colspan="4" style="text-align:center; color:#64748b;">No service lines recorded.</td>
                            </tr>
                        </tbody>
                        <tfoot t-if="o.maintenance_product_ids">
                            <tr>
                                <th style="text-align:right;">Total</th>
                                <th t-out="sum([line.quantity or 0 for line in o.maintenance_product_ids])"/>
                                <th/>
                                <th style="text-align:right;" t-out="'{:,.2f}'.format(sum([line.price_subtotal or 0.0 for line in o.maintenance_product_ids]))"/>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="o_pmg_section o_pmg_keep">
                    <div class="o_pmg_section-heading"><span class="o_pmg_num">6</span>Cost &amp; Exclusions</div>
                    <div class="o_pmg_section-body">
                        <table class="o_pmg_dl">
                            <tr t-if="o.annual_fee"><td class="o_pmg_dl-label">Annual Contract Fee</td><td class="o_pmg_dl-value"><span t-out="o.annual_fee" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                            <tr t-if="o.total_untaxed_amount"><td class="o_pmg_dl-label">Total Untaxed Amount</td><td class="o_pmg_dl-value"><span t-out="o.total_untaxed_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                        </table>
                        <p t-if="o.exclusions" style="margin-top:6px;"><strong>Exclusions:</strong> <span style="white-space: pre-line;" t-out="o.exclusions"/></p>
                    </div>
                </div>

                <t t-set="signature_slots" t-value="[
                    {'label': 'Service Provider Signature', 'name': o.vendor_id.name or ''},
                    {'label': 'Client Signature', 'name': o.customer_id.name or o.landlord_id.name or ''},
                ]"/>
                <t t-call="sgc_offplan_rental_property_management.property_report_signatures"/>
                <t t-set="report_name">Maintenance Contract</t>
                <t t-set="report_footer_note">This is a computer-generated document. No signature required unless amending contract terms.</t>
                <t t-call="sgc_offplan_rental_property_management.property_report_footer"/>
            </div>
          </t>
        </t>
    </template>
</odoo>
