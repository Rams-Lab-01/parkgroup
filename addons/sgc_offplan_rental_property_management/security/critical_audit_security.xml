<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            SGC Critical Change Audit - Record Rules (Rev 3 design §5.4)
            One company-scoped rule per audit model (event / field change / chain).
            Deliberately NO ('company_id', '=', False) branch: audit records always carry
            a company_id, and a False-company record must never be readable.
            EXEMPT: sgc.critical.audit.tenant is a database singleton (one row per
            deployment, raw-SQL bootstrapped) with no company dimension — it is not
            company-scoped and requires no record rule.

            The verdict log (sgc.critical.audit.verdict) carries company_id and is
            company-scoped like the rest. Its read ACL rows are added in
            security/ir.model.access.csv: model access does not create record rules,
            and zero ACL rows is what made two wizards fail for non-admin users.
        -->
        <record id="rule_critical_audit_event_company" model="ir.rule">
            <field name="name">Critical Audit Event: company-scoped read</field>
            <field name="model_id" ref="model_sgc_critical_audit_event"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
        </record>

        <record id="rule_critical_audit_field_change_company" model="ir.rule">
            <field name="name">Critical Audit Field Change: company-scoped read</field>
            <field name="model_id" ref="model_sgc_critical_audit_field_change"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
        </record>

        <record id="rule_critical_audit_chain_company" model="ir.rule">
            <field name="name">Critical Audit Chain: company-scoped read</field>
            <field name="model_id" ref="model_sgc_critical_audit_chain"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
        </record>

        <record id="rule_critical_audit_verdict_company" model="ir.rule">
            <field name="name">Critical Audit Verdict: company-scoped read</field>
            <field name="model_id" ref="model_sgc_critical_audit_verdict"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
        </record>
    </data>
</odoo>
