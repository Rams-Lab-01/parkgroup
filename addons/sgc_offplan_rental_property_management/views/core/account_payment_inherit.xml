<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_payment_smart_buttons" model="ir.ui.view">
        <field name="name">account.payment.smart.buttons</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="priority" eval="10" />
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="after">
                <button name="action_view_sale_contract" type="object"
                    string="Contract" icon="fa-building"
                    invisible="not invoice_ids or not invoice_ids[0].sold_id"
                    groups="base.group_user" />
                <button name="action_view_tenancy" type="object"
                    string="Tenancy" icon="fa-home"
                    invisible="not invoice_ids or not invoice_ids[0].tenancy_id"
                    groups="base.group_user" />
            </xpath>
        </field>
    </record>
</odoo>
