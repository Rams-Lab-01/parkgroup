<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_tree_project_unit" model="ir.ui.view">
        <field name="name">account.move.tree.project.unit.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="project_id" optional="show" string="Project" groups="base.group_user"/>
                <field name="property_unit_no" optional="show" string="Unit" groups="base.group_user"/>
            </xpath>
        </field>
    </record>

    <record id="account_move_tree_journal_project_unit" model="ir.ui.view">
        <field name="name">account.move.tree.journal.project.unit.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="project_id" optional="show" string="Project" groups="base.group_user"/>
                <field name="property_unit_no" optional="show" string="Unit" groups="base.group_user"/>
            </xpath>
        </field>
    </record>

</odoo>
