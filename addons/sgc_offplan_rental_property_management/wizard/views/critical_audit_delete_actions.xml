<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Critical-Change Audit (design 5.5) - Tier-1 delete-with-reason workflow.

        One bound window action per audit-governed model (mixin with
        _audit_unlink_requires_reason = True, enumerated in Entries 50 (21), 51 (+6) and 52 (+5)). The
        action opens the reason wizard on the current record or the current
        list selection; the wizard's Delete button registers the sanitized
        reason and performs the unlink in the same transaction (the reason
        registry is per-transaction, so the business action must live in the
        wizard).

        Context discipline (Entry 52, live defect 2026-09-20): the context is
        evaluated CLIENT-side by py.js, which exposes active_id/active_ids but
        NOT `len`; res_ids and the selection size are therefore computed in
        the wizard's default_get(), never in this context.

        A drift guard in tests/test_audit_delete_workflow.py asserts that every
        gated model in the registry has one of these bindings.
    -->
    <!-- account.move -->
    <record id="critical_audit_delete_with_reason_account_move" model="ir.actions.act_window">
        <field name="name">Delete with audit reason</field>
        <field name="res_model">sgc.critical.audit.reason.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_account_move"/>
        <field name="binding_view_types">list,form</field>
        <field name="context">{'default_model': 'account.move', 'default_res_id': active_id, 'default_operation': 'Record deleted', 'default_operation_kind': 'unlink'}</field>
    </record>

