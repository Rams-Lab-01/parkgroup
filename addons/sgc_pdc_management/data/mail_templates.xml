<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_pdc_upcoming" model="mail.template">
            <field name="name">PDC: upcoming cheque</field>
            <field name="model_id" ref="model_sgc_pdc_cheque"/>
            <field name="subject">Upcoming cheque {{ object.name }} - due {{ object.cheque_date }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.user_id.email_formatted }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px;">
    <p>Hello <t t-out="object.user_id.name or ''"/>,</p>
    <p>The following post-dated cheque is <b>approaching maturity</b>:</p>
    <table style="border-collapse: collapse;">
        <tr><td style="padding:2px 12px 2px 0;">Reference</td><td><b t-out="object.name"/></td></tr>
        <tr><td style="padding:2px 12px 2px 0;">Direction</td><td><t t-out="dict(object._fields['direction'].selection).get(object.direction)"/></td></tr>
        <tr><td style="padding:2px 12px 2px 0;">Party</td><td><t t-out="object.partner_id.display_name"/></td></tr>
        <tr><td style="padding:2px 12px 2px 0;">Cheque no. / Bank</td><td><t t-out="object.cheque_number"/> / <t t-out="object.bank_name or '-'"/></td></tr>
        <tr><td style="padding:2px 12px 2px 0;">Maturity date</td><td><b t-out="object.cheque_date"/> (in <t t-out="object.days_to_maturity"/> day(s))</td></tr>
        <tr><td style="padding:2px 12px 2px 0;">Amount</td><td><b t-out="format_amount(object.amount, object.currency_id)"/></td></tr>
        <tr><td style="padding:2px 12px 2px 0;">Property</td><td><t t-out="object.property_id.display_name or '-'"/></td></tr>
    </table>
    <p>Please prepare it for deposit.</p>
</div>
            </field>
        </record>

        <record id="mail_template_pdc_matured" model="mail.template">
            <field name="name">PDC: matured cheque</field>
            <field name="model_id" ref="model_sgc_pdc_cheque"/>
            <field name="subject">Matured cheque {{ object.name }} - action required</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.user_id.email_formatted }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px;">
    <p>Hello <t t-out="object.user_id.name or ''"/>,</p>
    <p>The following post-dated cheque has <b>matured</b> and is still
       <b t-out="dict(object._fields['state'].selection).get(object.state)"/>:</p>
    <table style="border-collapse: collapse;">
        <tr><td style="padding:2px 12px 2px 0;">Reference</td><td><b t-out="object.name"/></td></tr>
        <tr><td style="padding:2px 12px 2px 0;">Direction</td><td><t t-out="dict(object._fields['direction'].selection).get(object.direction)"/></td></tr>
        <tr><td style="padding:2px 12px 2px 0;">Party</td><td><t t-out="object.partner_id.display_name"/></td></tr>
        <tr><td style="padding:2px 12px 2px 0;">Cheque no. / Bank</td><td><t t-out="object.cheque_number"/> / <t t-out="object.bank_name or '-'"/></td></tr>
        <tr><td style="padding:2px 12px 2px 0;">Maturity date</td><td><b t-out="object.cheque_date"/></td></tr>
        <tr><td style="padding:2px 12px 2px 0;">Amount</td><td><b t-out="format_amount(object.amount, object.currency_id)"/></td></tr>
        <tr><td style="padding:2px 12px 2px 0;">Property</td><td><t t-out="object.property_id.display_name or '-'"/></td></tr>
    </table>
    <p>Please deposit / clear it, or mark it as bounced.</p>
</div>
            </field>
        </record>
    </data>
</odoo>
