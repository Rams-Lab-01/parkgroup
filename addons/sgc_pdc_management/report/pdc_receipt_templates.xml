<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pdc_receipt_document">
        <t t-set="o" t-value="doc"/>
        <t t-set="is_in" t-value="doc.direction == 'inbound'"/>
        <t t-call="web.external_layout">
            <div class="page" style="font-size: 13px;">

                <!-- Title block -->
                <div class="text-center mb-3">
                    <h2 class="mb-0" style="letter-spacing: 1px;">
                        <t t-if="is_in">POST-DATED CHEQUE RECEIPT</t>
                        <t t-else="">POST-DATED CHEQUE PAYMENT VOUCHER</t>
                    </h2>
                    <div class="text-muted">
                        <t t-if="is_in">Acknowledgement of cheque received</t>
                        <t t-else="">Record of cheque issued</t>
                    </div>
                </div>

                <!-- Reference block -->
                <table class="table table-sm table-borderless mb-3">
                    <tr>
                        <td style="width: 50%;"><strong>
                            <t t-if="is_in">Receipt No.</t><t t-else="">Voucher No.</t>:</strong>
                            <span t-field="doc.name"/></td>
                        <td class="text-end"><strong>Date:</strong>
                            <span t-field="doc.received_date"/></td>
                    </tr>
                </table>

                <!-- Parties -->
                <div class="row mb-3">
                    <div class="col-6">
                        <div style="font-weight: bold; border-bottom: 1px solid #999; margin-bottom: 4px;">
                            <t t-if="is_in">RECEIVED FROM</t><t t-else="">PAID TO</t>
                        </div>
                        <div t-field="doc.partner_id"
                             t-options='{"widget": "contact", "fields": ["name", "address", "phone", "email"], "no_marker": true}'/>
                        <div t-if="doc.partner_id.vat"><strong>TRN / VAT:</strong> <span t-field="doc.partner_id.vat"/></div>
                    </div>
                    <div class="col-6">
                        <div style="font-weight: bold; border-bottom: 1px solid #999; margin-bottom: 4px;">
                            <t t-if="is_in">RECEIVED BY</t><t t-else="">ISSUED BY</t>
                        </div>
                        <div><span t-field="doc.company_id.name"/></div>
                        <div t-if="doc.user_id">Officer: <span t-field="doc.user_id.name"/></div>
                    </div>
                </div>

                <!-- Cheque details -->
                <div style="font-weight: bold; border-bottom: 1px solid #999; margin-bottom: 4px;">CHEQUE DETAILS</div>
                <table class="table table-sm table-bordered mb-2">
                    <thead style="background-color: #f0f0f0;">
                        <tr>
                            <th>Cheque No.</th>
                            <th>Drawee Bank</th>
                            <th>Cheque Date (Maturity)</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span t-field="doc.cheque_number"/></td>
                            <td><span t-field="doc.bank_name"/></td>
                            <td><strong><span t-field="doc.cheque_date"/></strong></td>
                            <td class="text-end"><strong><span t-field="doc.amount"
                                t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></strong></td>
                        </tr>
                    </tbody>
                </table>
                <p class="mb-3"><strong>Amount in words:</strong>
                    <span t-out="doc.currency_id.amount_to_text(doc.amount)"/></p>

                <!-- Purpose / references -->
                <t t-if="doc.installment_id or doc.sale_contract_id or doc.tenancy_id or doc.rent_invoice_id or doc.invoice_id or doc.property_id">
                    <div style="font-weight: bold; border-bottom: 1px solid #999; margin-bottom: 4px;">IN RESPECT OF</div>
                    <table class="table table-sm table-borderless mb-3">
                        <tr t-if="doc.property_id"><td style="width: 30%;">Property / Unit</td>
                            <td><span t-field="doc.property_id.display_name"/></td></tr>
                        <tr t-if="doc.sale_contract_id"><td>Sale contract</td>
                            <td><span t-field="doc.sale_contract_id.display_name"/></td></tr>
                        <tr t-if="doc.installment_id"><td>Installment</td>
                            <td><span t-field="doc.installment_id.name"/></td></tr>
                        <tr t-if="doc.tenancy_id"><td>Tenancy</td>
                            <td><span t-field="doc.tenancy_id.display_name"/></td></tr>
                        <tr t-if="doc.rent_invoice_id"><td>Rent invoice</td>
                            <td><span t-field="doc.rent_invoice_id.display_name"/></td></tr>
                        <tr t-if="doc.invoice_id"><td>Invoice / bill</td>
                            <td><span t-field="doc.invoice_id.name"/></td></tr>
                    </table>
                </t>

                <!-- Lifecycle -->
                <div style="font-weight: bold; border-bottom: 1px solid #999; margin-bottom: 4px;">CHEQUE STATUS</div>
                <table class="table table-sm table-bordered mb-3">
                    <thead style="background-color: #f0f0f0;">
                        <tr><th>Received / Issued</th><th>Maturity</th><th>Deposited</th>
                            <th>Cleared</th><th>Bounced</th><th>Current Status</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span t-field="doc.received_date"/></td>
                            <td><span t-field="doc.cheque_date"/></td>
                            <td><t t-if="doc.deposit_date"><span t-field="doc.deposit_date"/></t><t t-else="">-</t></td>
                            <td><t t-if="doc.clear_date"><span t-field="doc.clear_date"/></t><t t-else="">-</t></td>
                            <td><t t-if="doc.bounce_date"><span t-field="doc.bounce_date"/></t><t t-else="">-</t></td>
                            <td><strong><span t-field="doc.state"/></strong></td>
                        </tr>
                    </tbody>
                </table>
                <p t-if="doc.bounce_reason"><strong>Bounce reason:</strong> <span t-field="doc.bounce_reason"/></p>

                <!-- Terms -->
                <p class="small text-muted mb-4" style="border-top: 1px solid #ddd; padding-top: 6px;">
                    <t t-if="is_in">
                        This receipt acknowledges receipt of the post-dated cheque described above. It is
                        not a receipt for payment: the amount is credited only when the cheque is
                        honoured by the bank. If the cheque is dishonoured, this receipt is void and the
                        amount remains due.
                    </t>
                    <t t-else="">
                        This voucher records the issue of the post-dated cheque described above. The
                        payment is complete only when the cheque is presented and honoured by the bank.
                    </t>
                </p>

                <!-- Signatures -->
                <div class="row" style="margin-top: 40px;">
                    <div class="col-4">
                        <div style="border-top: 1px solid #000; padding-top: 4px;">
                            <t t-if="is_in">Received by</t><t t-else="">Prepared by</t>
                            <t t-if="doc.user_id"> (<span t-out="doc.user_id.name"/>)</t>
                        </div>
                    </div>
                    <div class="col-4">
                        <div style="border-top: 1px solid #000; padding-top: 4px;">
                            <t t-if="is_in">Customer signature</t><t t-else="">Payee signature</t>
                        </div>
                    </div>
                    <div class="col-4">
                        <div style="border-top: 1px solid #000; padding-top: 4px;">Company stamp</div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_pdc_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang or user.lang)"/>
                <t t-call="sgc_pdc_management.report_pdc_receipt_document"/>
            </t>
        </t>
    </template>
</odoo>
