<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sgc_pdc_settings_form" model="ir.ui.view">
        <field name="name">sgc.pdc.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="PDC Settings" class="oe_form_configuration">
                <header>
                    <button string="Save" type="object" name="execute" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </header>
                <group string="Cheque alerts">
                    <field name="sgc_pdc_upcoming_days"/>
                    <field name="sgc_pdc_extra_notify_emails" placeholder="accounts@company.com, cfo@company.com"/>
                </group>
                <div class="text-muted">
                    A daily job alerts the responsible user (Odoo inbox, to-do activity and email) for
                    cheques maturing within the window above, and for cheques that have matured but are
                    still in hand or deposited.
                </div>
            </form>
        </field>
    </record>
    <record id="action_sgc_pdc_settings" model="ir.actions.act_window">
        <field name="name">PDC Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="view_id" ref="sgc_pdc_settings_form"/>
    </record>
</odoo>
