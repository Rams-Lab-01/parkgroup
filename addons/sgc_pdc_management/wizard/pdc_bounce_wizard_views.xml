<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sgc_pdc_bounce_wizard_form" model="ir.ui.view">
        <field name="name">sgc.pdc.bounce.wizard.form</field>
        <field name="model">sgc.pdc.bounce.wizard</field>
        <field name="arch" type="xml">
            <form string="Bounce Cheque">
                <group>
                    <field name="cheque_id" invisible="1"/>
                    <field name="reason" placeholder="e.g. Insufficient funds, signature mismatch"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Mark as Bounced" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
