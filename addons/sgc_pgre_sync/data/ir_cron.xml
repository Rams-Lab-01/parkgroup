<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_pgre_sync_poll" model="ir.cron">
            <field name="name">PGRE Sync: poll financials (15 min)</field>
            <field name="model_id" ref="model_pgre_sync_runner"/>
            <field name="state">code</field>
            <field name="code">model.cron_poll()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <record id="cron_pgre_sync_reconcile" model="ir.cron">
            <field name="name">PGRE Sync: nightly reconcile</field>
            <field name="model_id" ref="model_pgre_sync_runner"/>
            <field name="state">code</field>
            <field name="code">model.cron_reconcile()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 21:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
