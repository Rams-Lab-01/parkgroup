    Security groups. Loaded before the ACL CSV so the CSV rows can reference
    these groups by external id.

    Odoo 19 groups attach to a ``res.groups.privilege`` (which carries the
    ``ir.module.category``); the old ``res.groups.category_id`` field is gone.
-->
<odoo>

    <record id="module_category_project_costing" model="ir.module.category">
        <field name="name">Project Costing</field>
        <field name="description">Project budgets, cost tracking and collection timelines.</field>
        <field name="sequence">26</field>
    </record>

    <record id="privilege_project_costing" model="res.groups.privilege">
        <field name="name">Project Costing</field>
        <field name="category_id" ref="module_category_project_costing"/>
    </record>

    <record id="group_project_cost_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_project_costing"/>
        <field name="implied_ids" eval="[(4, ref('sgc_escrow.group_escrow_user'))]"/>
        <field name="comment">Read-only access to project budgets, costs and milestones.</field>
    </record>

    <record id="group_project_cost_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_project_costing"/>
        <field name="implied_ids"
               eval="[(4, ref('group_project_cost_user')), (4, ref('sgc_escrow.group_escrow_manager'))]"/>
        <field name="comment">Set project budgets, link analytic accounts and maintain cost milestones.</field>
    </record>

</odoo>
