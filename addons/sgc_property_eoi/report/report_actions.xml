<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_sgc_property_doc" model="report.paperformat">
        <field name="name">SGC Property Documents (A4)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">34</field>
        <field name="margin_bottom">22</field>
        <field name="margin_left">14</field>
        <field name="margin_right">14</field>
        <field name="header_spacing">28</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_property_eoi" model="ir.actions.report">
        <field name="name">EOI - Expression of Interest</field>
        <field name="model">property.eoi</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sgc_property_eoi.report_property_eoi</field>
        <field name="report_file">sgc_property_eoi.report_property_eoi</field>
        <field name="print_report_name">'EOI - %s' % (object.name or '').replace('/', '-')</field>
        <field name="binding_model_id" ref="model_property_eoi"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_sgc_property_doc"/>
    </record>

    <record id="action_report_booking_confirmation" model="ir.actions.report">
        <field name="name">Property Booking Confirmation</field>
        <field name="model">property.vendor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sgc_property_eoi.report_booking_confirmation</field>
        <field name="report_file">sgc_property_eoi.report_booking_confirmation</field>
        <field name="print_report_name">'Booking Confirmation - %s' % (object.name or '').replace('/', '-')</field>
        <field name="binding_model_id" ref="sgc_offplan_rental_property_management.model_property_vendor"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_sgc_property_doc"/>
    </record>
</odoo>
