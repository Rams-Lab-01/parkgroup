<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_property_eoi_company" model="ir.rule">
            <field name="name">Property EOI: multi-company</field>
            <field name="model_id" ref="model_property_eoi"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <!-- A group rule on a model REPLACES "no rule" for the users in that group, so everyone who legitimately
             sees payments today keeps full access through an explicit permissive rule. -->
        <record id="rule_account_payment_accounting_unrestricted" model="ir.rule">
            <field name="name">Payments: accounting and administrators keep full access</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="groups" eval="[(4, ref('account.group_account_invoice')),
                                        (4, ref('account.group_account_readonly')),
                                        (4, ref('account.group_account_user')),
                                        (4, ref('account.group_account_manager')),
                                        (4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_account_payment_sgc_linked" model="ir.rule">
            <field name="name">Payments: read-only for EOI / booking payments (property team)</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="groups" eval="[(4, ref('sgc_offplan_rental_property_management.property_rental_officer')),
                                        (4, ref('sgc_offplan_rental_property_management.property_rental_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">['|', ('sgc_eoi_ids', '!=', False), ('sgc_booking_ids', '!=', False)]</field>
        </record>
    </data>
</odoo>
