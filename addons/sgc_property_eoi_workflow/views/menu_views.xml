<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_eoi_contracts" model="ir.actions.act_window">
        <field name="name">EOI Registrations</field>
        <field name="res_model">sale.contract</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'eoi')]</field>
        <field name="context">{'default_state': 'eoi'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register an Expression of Interest (EOI)
            </p>
            <p>
                Record pre-launch refundable buyer deposits before opening official booking and sales purchase agreements.
            </p>
        </field>
    </record>

    <menuitem id="menu_eoi_contracts"
        name="EOI Registrations"
        parent="sgc_offplan_rental_property_management.menu_contracts_root"
        action="action_eoi_contracts"
        sequence="3"/>
</odoo>
