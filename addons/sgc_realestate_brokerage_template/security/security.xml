<?xml version="1.0" encoding="utf-8"?>
<!--
    SGC Realestate Brokerage Template — security

    All groups below are tenant-scoped — they inherit `res_company` via
    `rule.domain_force`. No global group unlocks a tenant record for any
    user outside that tenant's company.
-->
<odoo>
    <data noupdate="1">

        <!-- No top-level "Real Estate" ir.module.category exists in Odoo 19
             Community's base module (verified absent via a clean-room
             install test, 2026-08-31 — a prior version of this file
             referenced the nonexistent xmlid `base.module_category_real_estate`,
             which broke installation with a ParseError). This category is
             therefore created as its own top-level entry, not parented. -->
        <record id="module_category_realestate" model="ir.module.category">
            <field name="name">Real Estate</field>
            <field name="sequence">20</field>
        </record>

        <!-- Odoo 19 restructured group categorisation: `res.groups` no
             longer carries a direct `category_id` field (verified absent
             via the same clean-room install test — a prior version of
             this file used the pre-19 `category_id` field on res.groups
             directly, which broke installation with
             `ValueError: Invalid field 'category_id' in 'res.groups'`).
             The category is now reached one level deeper, through
             `res.groups.privilege_id` -> `res.groups.privilege.category_id`.
             This privilege record is the required intermediate. -->
        <record id="privilege_realestate" model="res.groups.privilege">
            <field name="name">Real Estate</field>
            <field name="category_id" ref="module_category_realestate"/>
        </record>

        <record id="group_realestate_brokerage_user" model="res.groups">
            <field name="name">Real-estate / Brokerage User</field>
            <field name="privilege_id" ref="privilege_realestate"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Standard user of the brokerage tenant — read-only on tenant
                configuration, full CRUD on listings / leads / deals.
            </field>
        </record>

        <record id="group_realestate_brokerage_manager" model="res.groups">
            <field name="name">Real-estate / Brokerage Manager</field>
            <field name="privilege_id" ref="privilege_realestate"/>
            <field name="implied_ids" eval="[(4, ref('group_realestate_brokerage_user'))]"/>
            <!-- Odoo 19 renamed `res.groups.users` to `user_ids` (verified
                 via the same clean-room install test — a prior version of
                 this file used the pre-19 `users` field, which broke
                 installation with `ValueError: Invalid field 'users' in
                 'res.groups'`). -->
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">
                Tenant administrator — can configure tenant-level fields
                and run the activation preflight.
            </field>
        </record>

        <record id="group_realestate_audit_reviewer" model="res.groups">
            <field name="name">Real-estate / Audit Reviewer</field>
            <field name="privilege_id" ref="privilege_realestate"/>
            <field name="comment">
                Read-only access to the hold-list, blocker log, and
                provenance mapping. Used by counsel and audit reviewers.
            </field>
        </record>

        <!-- Tenant-scoped multi-company rule -->
        <record id="rule_brokerage_tenant_company" model="ir.rule">
            <field name="name">Brokerage Tenant: company-scoped access</field>
            <field name="model_id" ref="model_sgc_brokerage_tenant"/>
            <field name="domain_force">
                [('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[
                (4, ref('group_realestate_brokerage_user')),
                (4, ref('group_realestate_brokerage_manager')),
            ]"/>
        </record>

        <record id="rule_brokerage_kit_readonly" model="ir.rule">
            <field name="name">Brokerage Kit: read-only for users</field>
            <field name="model_id" ref="model_sgc_brokerage_kit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('group_realestate_brokerage_user'))]"/>
        </record>

        <record id="rule_brokerage_kit_manager" model="ir.rule">
            <field name="name">Brokerage Kit: manager access</field>
            <field name="model_id" ref="model_sgc_brokerage_kit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_realestate_brokerage_manager'))]"/>
        </record>

        <!-- Tenant-scoped multi-company rules for the models the header
             comment above already claims are protected but previously had
             no ir.rule at all. -->

        <record id="rule_re_unit_company" model="ir.rule">
            <field name="name">RE Unit: company-scoped access</field>
            <field name="model_id" ref="model_re_unit"/>
            <field name="domain_force">[('tenant_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[
                (4, ref('group_realestate_brokerage_user')),
                (4, ref('group_realestate_brokerage_manager')),
            ]"/>
        </record>

        <record id="rule_brokerage_incident_company" model="ir.rule">
            <field name="name">Brokerage Incident: company-scoped access</field>
            <field name="model_id" ref="model_sgc_brokerage_incident"/>
            <field name="domain_force">[('tenant_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[
                (4, ref('group_realestate_brokerage_user')),
                (4, ref('group_realestate_brokerage_manager')),
            ]"/>
        </record>

        <record id="rule_compliance_event_company" model="ir.rule">
            <field name="name">Compliance Event: company-scoped access</field>
            <field name="model_id" ref="model_sgc_compliance_event"/>
            <field name="domain_force">[('tenant_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[
                (4, ref('group_realestate_brokerage_user')),
                (4, ref('group_realestate_brokerage_manager')),
            ]"/>
        </record>

        <record id="rule_integration_source_company" model="ir.rule">
            <field name="name">Integration Source: company-scoped access</field>
            <field name="model_id" ref="model_sgc_integration_source"/>
            <field name="domain_force">[('tenant_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[
                (4, ref('group_realestate_brokerage_user')),
                (4, ref('group_realestate_brokerage_manager')),
            ]"/>
        </record>

        <record id="rule_migration_source_map_company" model="ir.rule">
            <field name="name">Migration Source Map: company-scoped access</field>
            <field name="model_id" ref="model_sgc_migration_source_map"/>
            <field name="domain_force">[('tenant_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[
                (4, ref('group_realestate_brokerage_user')),
                (4, ref('group_realestate_brokerage_manager')),
            ]"/>
        </record>

        <record id="rule_migration_run_company" model="ir.rule">
            <field name="name">Migration Run: company-scoped access</field>
            <field name="model_id" ref="model_sgc_migration_run"/>
            <field name="domain_force">[('tenant_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[
                (4, ref('group_realestate_brokerage_user')),
                (4, ref('group_realestate_brokerage_manager')),
            ]"/>
        </record>

        <record id="rule_migration_run_log_company" model="ir.rule">
            <field name="name">Migration Run Log: company-scoped access</field>
            <field name="model_id" ref="model_sgc_migration_run_log"/>
            <field name="domain_force">[('run_id.tenant_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[
                (4, ref('group_realestate_brokerage_user')),
                (4, ref('group_realestate_brokerage_manager')),
            ]"/>
        </record>

        <record id="rule_strategy_layer_priority_company" model="ir.rule">
            <field name="name">Strategy Layer Priority: company-scoped access</field>
            <field name="model_id" ref="model_sgc_strategy_layer_priority"/>
            <field name="domain_force">[('tenant_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[
                (4, ref('group_realestate_brokerage_user')),
                (4, ref('group_realestate_brokerage_manager')),
            ]"/>
        </record>

        <record id="rule_wa_log_company" model="ir.rule">
            <field name="name">WhatsApp Log: company-scoped access</field>
            <field name="model_id" ref="model_sgc_wa_log"/>
            <field name="domain_force">[('tenant_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[
                (4, ref('group_realestate_brokerage_user')),
                (4, ref('group_realestate_brokerage_manager')),
            ]"/>
        </record>

    </data>
</odoo>
