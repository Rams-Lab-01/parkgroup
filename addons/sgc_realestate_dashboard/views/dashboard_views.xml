<odoo>

    <!-- ── The dashboard board (OWL client action) ── -->
    <record id="action_realestate_dashboard" model="ir.actions.client">
        <field name="name">Real Estate Dashboard</field>
        <field name="tag">sgc_realestate_dashboard</field>
    </record>

    <menuitem id="menu_realestate_dashboard"
              name="Dashboard"
              parent="sgc_offplan_rental_property_management.main_menu_rental_management"
              action="action_realestate_dashboard"
              sequence="1"
              groups="sgc_offplan_rental_property_management.property_rental_manager,sgc_offplan_rental_property_management.property_rental_officer,sales_team.group_sale_manager"/>

    <!-- ── Native analytics (resilient drill-down views) ── -->
    <record id="view_sale_contract_graph_state" model="ir.ui.view">
        <field name="name">sale.contract.graph.state</field>
        <field name="model">sale.contract</field>
        <field name="arch" type="xml">
            <graph type="bar" string="Contracts by Status">
                <field name="state"/>
                <field name="sale_price" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_property_details_graph_state" model="ir.ui.view">
        <field name="name">property.details.graph.state</field>
        <field name="model">property.details</field>
        <field name="arch" type="xml">
            <graph type="bar" string="Inventory by Status">
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="action_realestate_sales_analytics" model="ir.actions.act_window">
        <field name="name">Sales Analytics</field>
        <field name="res_model">sale.contract</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>

    <menuitem id="menu_realestate_sales_analytics"
              name="Sales Analytics"
              parent="menu_realestate_dashboard"
              action="action_realestate_sales_analytics"
              sequence="2"
              groups="sgc_offplan_rental_property_management.property_rental_manager,sgc_offplan_rental_property_management.property_rental_officer,sales_team.group_sale_manager"/>

</odoo>
